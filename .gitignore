node_modules/
dist/
*.local
.DS_Store
.vite/
npm-debug.log*

# tsc -b writes these even under noEmit
*.tsbuildinfo

# wrangler's local state (miniflare D1, logs) from `wrangler pages dev`
.wrangler/

# Secrets never enter git: .dev.vars is where `wrangler pages dev` reads the
# assistant's key and password locally, and a .env could hold the same.
.dev.vars*
.env*

# CPython writes these when a script imports the harness to generate tests
__pycache__/
*.pyc
