{
  "id": "longest-substring-without-repeating-characters",
  "title": "Longest Substring Without Repeating Characters",
  "difficulty": "M",
  "lc": {"num": 3, "slug": "longest-substring-without-repeating-characters"},
  "topics": ["sliding window", "hash map", "string"],
  "kind": "function",
  "entry": "lengthOfLongestSubstring",
  "params": [{"name": "s"}],
  "starter": "class Solution:\n    def lengthOfLongestSubstring(self, s: str) -> int:\n        pass\n",
  "tests": [
    {"args": ["cabbage"], "expected": 4, "show": true},
    {"args": ["go go"], "expected": 3, "show": true},
    {"args": [""], "expected": 0, "show": true},
    {"args": ["z"], "expected": 1, "label": "one character"},
    {"args": ["aaaa"], "expected": 1, "label": "one character repeated"},
    {"args": ["abcdef"], "expected": 6, "label": "no repeats at all"},
    {"args": ["abba"], "expected": 2, "label": "previous copy is outside the window"},
    {"args": ["xyyzwx"], "expected": 4, "label": "old copy before the window start"},
    {"args": ["aAbB"], "expected": 4, "label": "case matters"},
    {"args": ["1+1=2!"], "expected": 5, "label": "digits and symbols"},
    {"args": ["   "], "expected": 1, "label": "only spaces"},
    {"args": ["abcdaa"], "expected": 4, "label": "longest run at the start"},
    {"args": ["aabcde"], "expected": 5, "label": "longest run at the end"},
    {"args": ["abcabc"], "expected": 3, "label": "two equal halves"},
    {"args": ["pqrstpabcdefghq"], "expected": 13, "label": "window jumps past the first repeat"},
    {"args": [" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"], "expected": 95, "label": "all 95 printable characters"},
    {"args": ["beebcedeaeadcebbdeeddbbbedaabe"], "expected": 5, "label": "random"},
    {"args": ["ababbbbbbabaaababbbbbbbab"], "expected": 2, "label": "random"},
    {"args": ["aejcfijjbdjeebbhhbfbgcaeggbajjagjfieidaeabbjiadgejecafffcggh"], "expected": 7, "label": "random"},
    {"args": ["bQrlwg-o`BWq|{>FWAbFfK!UjH\"Pnkp1'qpJ[MvMmzC~^\"k'v\"O@pZFklH6N7HOlAFP-#hw~0G`<sB>I"], "expected": 22, "label": "random"},
    {"args": ["y xxzzy yxzy zyxxyzyzzxzy zz z z  x yyx "], "expected": 4, "label": "random"},
    {"args": ["nhbojkhcjdhbbgnbapdfjhanbdkeipblhgddfhieapmbihinbpkabebdbcpbcpkfkclmmjligkndeamcfblombnblpknnoahgicn"], "expected": 13, "label": "random"},
    {"argsPy": "r = rng(30)\nargs = [''.join(chr(r.randint(32, 126)) for _ in range(5 * 10**4))]", "expected": 38, "label": "large: 50,000 random printable characters", "perf": true},
    {"argsPy": "p = [chr(c) for c in range(32, 127)]\nargs = [''.join(p * 527)[:5 * 10**4]]", "expected": 95, "label": "large: all 95 printable characters, cycled", "perf": true}
  ]
}
