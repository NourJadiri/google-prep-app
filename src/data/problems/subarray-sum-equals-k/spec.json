{
  "id": "subarray-sum-equals-k",
  "title": "Subarray Sum Equals K",
  "difficulty": "M",
  "lc": {"num": 560, "slug": "subarray-sum-equals-k"},
  "topics": ["prefix sum", "hash map"],
  "kind": "function",
  "entry": "subarraySum",
  "params": [{"name": "nums"}, {"name": "k"}],
  "starter": "class Solution:\n    def subarraySum(self, nums: List[int], k: int) -> int:\n        pass\n",
  "tests": [
    {"args": [[2, -1, 1, 3, -2], 3], "expected": 3, "show": true},
    {"args": [[1, -1, 1, -1], 0], "expected": 4, "show": true},
    {"args": [[3, 3, 3], 6], "expected": 2, "show": true},
    {"args": [[7], 7], "expected": 1, "label": "one number, equal to k"},
    {"args": [[7], -7], "expected": 0, "label": "one number, not k"},
    {"args": [[0, 0, 0], 0], "expected": 6, "label": "zeros, k = 0"},
    {"args": [[0, 5, 0], 5], "expected": 4, "label": "zeros around a hit"},
    {"args": [[3, 4, 7], 7], "expected": 2, "label": "a hit starting at index 0"},
    {"args": [[1, 2, 3, 4], 10], "expected": 1, "label": "only the whole list"},
    {"args": [[1, 2, 3], 7], "expected": 0, "label": "no subarray works"},
    {"args": [[-1, -2, 3, -3], -3], "expected": 3, "label": "negative k"},
    {"args": [[2, 2, 2, 2, 2], 4], "expected": 4, "label": "all equal"},
    {"args": [[1, -1, 1, -1, 1, -1], 0], "expected": 9, "label": "alternating signs, k = 0"},
    {"args": [[5, -5, 5, -5, 5], 5], "expected": 6, "label": "a value that keeps coming back"},
    {"args": [[1000, -1000, 1000], 1000], "expected": 3, "label": "extreme values"},
    {"args": [[1000, 1000, 1000, 1000], 10000000], "expected": 0, "label": "k larger than any sum"},
    {"args": [[-1000, -1000, -1000], -3000], "expected": 1, "label": "all negative, the whole list"},
    {"args": [[-2, 4, 1, -1, -4, -4, -5, -1, -2, 3], -8], "expected": 3, "label": "random"},
