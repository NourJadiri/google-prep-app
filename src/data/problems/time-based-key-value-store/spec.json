    {"argsPy": "r = rng(9810)\nops, xs, t = ['TimeMap'], [[]], 0\nfor i in range(25000):\n    t += r.randint(1, 300)\n    ops.append('set'); xs.append(['hot' if r.random() < 0.9 else 'k' + str(r.randrange(20)), 'v' + str(i), t])\nfor _ in range(25000):\n    ops.append('get'); xs.append(['hot' if r.random() < 0.9 else 'k' + str(r.randrange(25)), r.randint(1, t + 100)])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 25,000 versions, then 25,000 lookups", "perf": true},
