    {"ops": ["TimeMap", "set", "set", "get", "get", "get", "get"], "args": [[], ["door", "red", 3], ["door", "blue", 8], ["door", 2], ["door", 3], ["door", 7], ["door", 100]], "expected": [null, null, null, "", "red", "red", "blue"], "show": true},
    {"ops": ["TimeMap", "set", "set", "set", "get", "get", "get"], "args": [[], ["a", "x", 1], ["b", "y", 2], ["a", "z", 5], ["b", 4], ["a", 4], ["c", 9]], "expected": [null, null, null, null, "y", "x", ""], "show": true},
    {"ops": ["TimeMap", "get"], "args": [[], ["k", 1]], "expected": [null, ""], "label": "get before any set"},
    {"ops": ["TimeMap", "set", "get", "set", "get", "get", "get"], "args": [[], ["k", "v1", 5], ["k", 5], ["k", "v2", 10], ["k", 10], ["k", 9], ["k", 11]], "expected": [null, null, "v1", null, "v2", "v1", "v2"], "label": "exact timestamps"},
