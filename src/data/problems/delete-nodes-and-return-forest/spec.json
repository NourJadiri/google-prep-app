    {"args": [[5, 9, 2, 4, 7, null, 8, null, null, 3, 6], [9, 8]], "show": true, "expected": [[4], [5, null, 2], [7, 3, 6]]},
    {"args": [[1, 2, 3, null, 4], [1, 2]], "show": true, "expected": [[3], [4]]},
    {"args": [[4, 2], [2, 4]], "show": true, "expected": []},
    {"args": [[3, 1, 2], [9]], "label": "nothing to delete is in the tree", "expected": [[3, 1, 2]]},
    {"args": [[1, 2, 3], [1]], "label": "only the root goes", "expected": [[2], [3]]},
    {"args": [[1, 2, 3], [3]], "label": "a leaf goes", "expected": [[1, 2]]},
    {"args": [[1], [1]], "label": "one node, deleted", "expected": []},
    {"args": [[1], [2]], "label": "one node, kept", "expected": [[1]]},
