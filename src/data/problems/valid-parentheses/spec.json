{
  "id": "valid-parentheses",
  "title": "Valid Parentheses",
  "difficulty": "E",
  "lc": {"num": 20, "slug": "valid-parentheses"},
  "topics": ["stack", "string"],
  "kind": "function",
  "entry": "isValid",
  "params": [{"name": "s"}],
  "starter": "class Solution:\n    def isValid(self, s: str) -> bool:\n        pass\n",
  "tests": [
    {"args": ["[{()}]()"], "expected": true, "show": true},
    {"args": ["{(})"], "expected": false, "show": true},
    {"args": ["(()"], "expected": false, "show": true},
    {"args": ["("], "expected": false, "label": "one character: an opener"},
    {"args": ["]"], "expected": false, "label": "one character: a closer"},
    {"args": ["{}"], "expected": true, "label": "smallest balanced string"},
    {"args": ["{)"], "expected": false, "label": "closed by the wrong kind"},
    {"args": [")("], "expected": false, "label": "a closer before any opener"},
    {"args": ["[]]"], "expected": false, "label": "one closer too many at the end"},
    {"args": ["}{}{"], "expected": false, "label": "closer first, opener last"},
    {"args": ["[(])"], "expected": false, "label": "crossed pairs: counts match, order doesn't"},
    {"args": ["{[(])}"], "expected": false, "label": "crossed deep inside"},
    {"args": ["{}()[]"], "expected": true, "label": "pairs side by side"},
    {"args": ["(((((((((((())))))))))))"], "expected": true, "label": "deep nesting"},
    {"args": ["([]{[]})[]"], "expected": true, "label": "nested and side by side"},
    {"args": ["[[{{(("], "expected": false, "label": "only openers"},
    {"args": ["))]]}}"], "expected": false, "label": "only closers"},
    {"args": ["(){}["], "expected": false, "label": "balanced until one last opener"},
    {"args": ["{{[]{}}()}()((){})"], "expected": true, "label": "random, balanced"},
    {"args": ["{}()[()({}([])[]){{}[([][])]}]"], "expected": true, "label": "random, balanced"},
    {"args": ["([({}{(())[()()[()]{{{{[{{()[[]]}}]}}}}]})])"], "expected": true, "label": "random, balanced"},
    {"args": ["{}{[()]}{([])[]()[])"], "expected": false, "label": "random, one character changed"},
    {"args": ["[]()[]{{{[]}[{}]}[)[]}{[[{}]]}[][]"], "expected": false, "label": "random, one character changed"},
    {"args": ["[{{{[][]{[()([[([}{{}}{{}{[]}}{}[]{})()]])]}}}}]"], "expected": false, "label": "random, one character changed"},
    {"argsPy": "['(' * 5000 + ')' * 5000]", "expected": true, "label": "large: 10,000 characters nested 5,000 deep", "perf": true},
    {"argsPy": "r = rng(20)\nL = 10000\nout, st = [], []\nwhile len(out) < L:\n    if st and (len(st) == L - len(out) or r.random() < 0.5):\n        out.append(')]}'['([{'.index(st.pop())])\n    else:\n        c = r.choice('([{')\n        st.append(c)\n        out.append(c)\nargs = [''.join(out)]", "expected": true, "label": "large: 10,000 random characters, balanced", "perf": true},
    {"argsPy": "r = rng(21)\nL = 9998\nout, st = [], []\nwhile len(out) < L:\n    if st and (len(st) == L - len(out) or r.random() < 0.5):\n        out.append(')]}'['([{'.index(st.pop())])\n    else:\n        c = r.choice('([{')\n        st.append(c)\n        out.append(c)\nargs = ['{' + ''.join(out) + ']']", "expected": false, "label": "large: wrong closer at the very last character", "perf": true}
  ]
}
