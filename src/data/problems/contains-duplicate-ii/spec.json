{
  "id": "contains-duplicate-ii",
  "title": "Contains Duplicate II",
  "difficulty": "E",
  "lc": {"num": 219, "slug": "contains-duplicate-ii"},
  "topics": ["array", "hash map", "sliding window"],
  "kind": "function",
  "entry": "containsNearbyDuplicate",
  "params": [{"name": "nums"}, {"name": "k"}],
  "starter": "class Solution:\n    def containsNearbyDuplicate(self, nums: List[int], k: int) -> bool:\n        pass\n",
  "tests": [
    {"args": [[5, 8, 3, 8, 1], 2], "expected": true, "show": true},
    {"args": [[6, 2, 9, 6], 2], "expected": false, "show": true},
    {"args": [[4, 4], 0], "expected": false, "show": true},
    {"args": [[1], 0], "expected": false, "label": "one element"},
    {"args": [[1], 5], "expected": false, "label": "one element, large k"},
    {"args": [[4, 5, 6, 4], 3], "expected": true, "label": "exactly k apart"},
    {"args": [[4, 5, 6, 4], 2], "expected": false, "label": "one more than k apart"},
    {"args": [[9, 9, 9], 0], "expected": false, "label": "k = 0, equal neighbours"},
    {"args": [[2, 9, 9], 1], "expected": true, "label": "k = 1, equal neighbours"},
    {"args": [[1, 2, 1], 100], "expected": true, "label": "k far bigger than the list"},
    {"args": [[7, 1, 2, 7, 4, 7], 2], "expected": true, "label": "the first copy is too far, two later ones are close"},
    {"args": [[1, 2, 3, 4, 5, 1, 9, 1], 2], "expected": true, "label": "a value comes back twice: only the later copies are close"},
    {"args": [[3, 3, 3, 3], 1], "expected": true, "label": "all equal"},
    {"args": [[1, 2, 3, 4, 5], 4], "expected": false, "label": "all distinct"},
    {"args": [[-1000000000, 1000000000, -1000000000], 2], "expected": true, "label": "extremes"},
    {"args": [[-1, 0, -1, 0], 1], "expected": false, "label": "negatives, copies two apart"},
    {"args": [[1, 2, 3, 4, 1, 2, 3, 4], 3], "expected": false, "label": "every copy four apart, k = 3"},
    {"args": [[1, 2, 3, 4, 1, 2, 3, 4], 4], "expected": true, "label": "every copy four apart, k = 4"},
    {"args": [[5, 6, 7, 8, 9, 0, 5], 6], "expected": true, "label": "the pair spans the whole list"},
    {"args": [[22, 20, 10, 16, 1, 10, 22, 23, 3, 25, 9, 13, 10, 9, 15, 1, 4, 1, 20, 25], 3], "expected": true, "label": "random"},
    {"args": [[6, -4, 29, -33, -31, -34, -45, -16, -8, 0, -10, 20, -41, 16, 42, -38, 12, -9, 39, 40, 50, 43, -3, -3, -9, -48, -44, -49, -35, 50], 4], "expected": true, "label": "random"},
    {"args": [[9, 13, 0, 3, 1, 11, 11, 13, 2, 1, 2, 14, 11, 11, 5, 10, 3, 12, 12, 14, 0, 0, 7, 3, 9, 0, 14, 5, 5, 5, 2, 8, 13, 12, 10, 7, 13, 7, 7, 13], 1], "expected": true, "label": "random"},
    {"args": [[751092890, 155983491, 480486992, 639909824, -609594845, -555207170, -714662950, 444131912, 694526610, -960504864, -195949468, -676347012, -842514485, -469206773, -921144889, 25238944, -792399158, 616826351, -111290354, 358931402, 303125432, 188011688, 966122744, 842203990, -911072915, 749179900, -865429186, -840524835, -91838013, 988055971, 290862161, 205206973, -78559364, -243419802, 678426423, -554860012, -23682359, 545363215, -460256982, 732988367, 299943087, -394976883, -823767742, 530753357, 910704438, 339693685, 242558636, -212283415, 681774381, 544960975], 49], "expected": false, "label": "random, all distinct"},
    {"argsPy": "[list(range(10**5)), 10**5]", "expected": false, "label": "large: 100,000 distinct values, k = 100,000", "perf": true},
    {"argsPy": "[list(range(5 * 10**4)) * 2, 5 * 10**4 - 1]", "expected": false, "label": "large: every copy is exactly k + 1 apart", "perf": true},
    {"argsPy": "[list(range(10**5 - 2)) + [0, 0], 5 * 10**4]", "expected": true, "label": "large: 0's first copy is far away, its last two are side by side", "perf": true}
  ]
}
