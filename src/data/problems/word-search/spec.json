{
  "id": "word-search",
  "title": "Word Search",
  "difficulty": "M",
  "lc": {"num": 79, "slug": "word-search"},
  "topics": ["grid", "backtracking", "dfs"],
  "kind": "function",
  "entry": "exist",
  "params": [{"name": "board"}, {"name": "word"}],
  "starter": "class Solution:\n    def exist(self, board: List[List[str]], word: str) -> bool:\n        pass\n",
  "tests": [
    {"args": [[["P", "L", "O", "S"], ["E", "A", "T", "R"], ["S", "N", "E", "A"]], "PLANET"], "expected": true, "show": true},
    {"args": [[["P", "L", "O", "S"], ["E", "A", "T", "R"], ["S", "N", "E", "A"]], "SEAS"], "expected": false, "show": true},
    {"args": [[["A", "B"]], "ABA"], "expected": false, "show": true},
    {"args": [[["a"]], "a"], "expected": true, "label": "one cell, one letter"},
    {"args": [[["a"]], "b"], "expected": false, "label": "one cell, wrong letter"},
    {"args": [[["a"]], "aa"], "expected": false, "label": "the only cell can't be used twice"},
    {"args": [[["a", "A"]], "aA"], "expected": true, "label": "lowercase then uppercase"},
    {"args": [[["a", "A"]], "AA"], "expected": false, "label": "case matters: there is only one A"},
    {"args": [[["x", "y"], ["z", "w"]], "xywzx"], "expected": false, "label": "longer than the board"},
    {"args": [[["a", "b", "c"], ["f", "e", "d"]], "abcdef"], "expected": true, "label": "uses every cell"},
    {"args": [[["a", "b", "c"], ["h", "i", "d"], ["g", "f", "e"]], "abcdefghi"], "expected": true, "label": "spirals through every cell"},
    {"args": [[["a", "b", "a"], ["b", "a", "a"], ["b", "a", "a"]], "aaabab"], "expected": true, "label": "a dead end must hand its cells back"},
    {"args": [[["a", "a", "a"], ["b", "b", "b"], ["a", "b", "a"]], "bbababa"], "expected": true, "label": "a failed start must hand its cells back"},
    {"args": [[["s", "d", "k"], ["e", "r", "o"], ["y", "x", "w"]], "words"], "expected": true, "label": "the path heads up and left"},
    {"args": [[["s", "t", "r", "e", "a", "m"]], "maerts"], "expected": true, "label": "single row, read backwards"},
    {"args": [[["q"], ["u"], ["e"], ["u"], ["e"], ["s"]], "queue"], "expected": true, "label": "single column"},
    {"args": [[["c", "a", "t"], ["d", "o", "g"], ["e", "l", "k"]], "zebra"], "expected": false, "label": "the first letter isn't on the board"},
    {"args": [[["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"]], "AAAAAAAAAAAAAAA"], "expected": true, "label": "fifteen letters on a uniform board"},
    {"args": [[["B", "B", "D", "A", "D"], ["D", "A", "C", "C", "A"], ["B", "D", "C", "B", "A"], ["A", "A", "A", "A", "D"]], "DBDACCAD"], "expected": true, "label": "random"},
    {"args": [[["a", "a", "c", "a", "a"], ["a", "a", "c", "b", "c"], ["a", "b", "c", "c", "b"], ["a", "a", "b", "b", "b"], ["c", "b", "c", "b", "b"]], "babcbabaaa"], "expected": false, "label": "random"},
    {"args": [[["a", "b", "B", "B", "b", "a"], ["A", "A", "b", "B", "b", "b"], ["B", "B", "B", "b", "b", "B"], ["B", "A", "B", "a", "A", "b"], ["B", "B", "b", "a", "A", "a"], ["A", "a", "a", "B", "B", "B"]], "AabBaABBBAab"], "expected": true, "label": "random"},
    {"args": [[["D", "D", "E", "A", "B", "D"], ["B", "E", "C", "E", "E", "E"], ["C", "B", "C", "C", "A", "C"], ["A", "B", "E", "E", "E", "B"], ["C", "E", "C", "B", "D", "C"], ["E", "D", "B", "A", "A", "E"]], "CEBEECCBCBEAEDD"], "expected": false, "label": "random"},
    {"args": [[["y", "x", "x", "y", "y", "y"], ["z", "y", "y", "x", "x", "x"], ["x", "z", "x", "y", "z", "z"], ["z", "x", "z", "x", "y", "z"], ["x", "x", "y", "y", "z", "x"]], "xzyxzxzxxyy"], "expected": true, "label": "random"},
    {"args": [[["b", "b", "b", "a", "a", "a"], ["a", "b", "a", "a", "a", "b"], ["a", "a", "b", "a", "a", "b"], ["b", "b", "b", "a", "b", "b"], ["b", "a", "b", "a", "b", "b"], ["b", "b", "b", "a", "a", "a"]], "baababbabbabaa"], "expected": false, "label": "random"},
    {"args": [[["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"]], "AAAAAAAAAB"], "expected": false, "label": "uniform board, last letter missing: every path gets tried", "perf": true},
    {"args": [[["B", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"], ["A", "A", "A", "A", "A", "A"]], "AAAAAAAAAAAAAAB"], "expected": true, "label": "the rare letter comes last", "perf": true}
  ]
}
