{
  "id": "find-pivot-index",
  "title": "Find Pivot Index",
  "difficulty": "E",
  "lc": {"num": 724, "slug": "find-pivot-index"},
  "topics": ["array", "prefix sum"],
  "kind": "function",
  "entry": "pivotIndex",
  "params": [{"name": "nums"}],
  "starter": "class Solution:\n    def pivotIndex(self, nums: List[int]) -> int:\n        pass\n",
  "tests": [
    {"args": [[2, 3, 0, 0, 5]], "expected": 2, "show": true},
    {"args": [[4, -4, 9]], "expected": 2, "show": true},
    {"args": [[3, 1, 4]], "expected": -1, "show": true},
    {"args": [[7]], "expected": 0, "label": "one element: both sides are empty"},
    {"args": [[0]], "expected": 0, "label": "a single zero"},
    {"args": [[1, -1]], "expected": -1, "label": "two elements, no pivot"},
    {"args": [[0, 0]], "expected": 0, "label": "two zeros"},
    {"args": [[5, 2, -2]], "expected": 0, "label": "pivot at index 0"},
    {"args": [[-3, 3, 7]], "expected": 2, "label": "pivot at the last index"},
    {"args": [[0, 0, 0, 0]], "expected": 0, "label": "all zeros: every index works"},
    {"args": [[1, 0, 0, 1]], "expected": 1, "label": "two pivots: the leftmost wins"},
    {"args": [[2, 2, 2]], "expected": 1, "label": "all equal, odd length"},
    {"args": [[2, 2, 2, 2]], "expected": -1, "label": "all equal, even length"},
    {"args": [[-1, -1, -1, -1, -1, 0]], "expected": 2, "label": "negatives"},
    {"args": [[1000, -1000, 1000, -1000, 1000]], "expected": 0, "label": "extremes"},
    {"args": [[3, -3, 5, -5, 0]], "expected": 4, "label": "the whole list sums to 0"},
    {"args": [[-7, 2, 5, 9, -9]], "expected": -1, "label": "pivot in the middle"},
    {"args": [[6, -4, 3, 5, -2, 17, 10, 15, 1, 8, 2, -1]], "expected": 6, "label": "random"},
    {"args": [[-19, 6, -6, -16, 20, -7, 17, 11, -12, 8, -18, 1, 14, 8, 17, -18]], "expected": 13, "label": "random"},
    {"args": [[-238, -378, -594, -626, 471, -826, -578, -429, 933, -659, 379, 968, 99, -407, 103, -902, 694, 164]], "expected": 2, "label": "random"},
    {"args": [[-1, -13, 11, -5, 2, 18, -6, -14, -17, -4]], "expected": -1, "label": "random, no pivot"},
    {"args": [[274, 521, 941, 493, -430, -684, -487, 261, -86, -862, -90, -319, 976, 331, -7, -127, -81, 584, -474, 272, -171, 463, -740, -560, 813]], "expected": -1, "label": "random, no pivot"},
    {"argsPy": "[[1] * 10**4]", "expected": -1, "label": "large: 10,000 ones, no pivot", "perf": true, "timeLimitMs": 1000},
    {"argsPy": "r = rng(7240)\nhalf = [r.randint(-1000, 1000) for _ in range(4999)]\nleft = half + [-v for v in half]\nr.shuffle(left)\nargs = [left + [0, r.randint(1, 1000)]]", "expected": 9999, "label": "large: 10,000 values, the pivot is the last index", "perf": true, "timeLimitMs": 1000}
  ]
}
