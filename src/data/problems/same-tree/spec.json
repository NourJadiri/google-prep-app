{
  "id": "same-tree",
  "title": "Same Tree",
  "difficulty": "E",
  "lc": {"num": 100, "slug": "same-tree"},
  "topics": ["binary tree", "recursion"],
  "kind": "function",
  "entry": "isSameTree",
  "params": [{"name": "p", "type": "TreeNode"}, {"name": "q", "type": "TreeNode"}],
  "starter": "# class TreeNode:\n#     def __init__(self, val=0, left=None, right=None):\n#         self.val = val\n#         self.left = left\n#         self.right = right\n\nclass Solution:\n    def isSameTree(self, p: Optional[TreeNode], q: Optional[TreeNode]) -> bool:\n        pass\n",
  "tests": [
    {"args": [[5, 3, 8, 1], [5, 3, 8, 1]], "expected": true, "show": true},
    {"args": [[4, 7], [4, null, 7]], "expected": false, "show": true},
    {"args": [[], [3]], "expected": false, "show": true},
    {"args": [[], []], "expected": true, "label": "both trees empty"},
    {"args": [[7], []], "expected": false, "label": "q is empty"},
    {"args": [[0], [0]], "expected": true, "label": "one node each, equal (value 0)"},
    {"args": [[1], [-1]], "expected": false, "label": "one node each, different values"},
    {"args": [[2, 1, 3], [2, 3, 1]], "expected": false, "label": "the children trade places"},
    {"args": [[2, 1], [1, null, 2]], "expected": false, "label": "same in-order values, different shape"},
    {"args": [[1, 2, null, 3], [1, 2, null, null, 3]], "expected": false, "label": "same preorder values, different shape"},
