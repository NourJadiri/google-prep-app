  "tests": [
    {"args": [[6, 2, 6, 2, 6]], "expected": 6, "show": true},
    {"args": [[9, 9, 5, 5, 5, 5, 9]], "expected": 5, "show": true},
    {"args": [[-1]], "expected": -1, "show": true},
    {"args": [[3, 3]], "expected": 3, "label": "two equal numbers"},
    {"args": [[1, 2, 2]], "expected": 2, "label": "the first number isn't the answer"},
    {"args": [[2, 1, 2]], "expected": 2, "label": "majority first and last"},
    {"args": [[7, 7, 7, 7, 7]], "expected": 7, "label": "all equal"},
    {"args": [[4, 4, 4, 7, 7, 7, 7]], "expected": 7, "label": "just over half, after a run of another value"},
    {"args": [[8, 8, 8, 8, 1, 2, 3]], "expected": 8, "label": "majority all at the front"},
    {"args": [[1, 2, 3, 4, 5, 5, 5, 5, 5]], "expected": 5, "label": "majority all at the end"},
    {"args": [[5, 1, 5, 2, 5, 3, 5]], "expected": 5, "label": "interleaved with different values"},
    {"args": [[2, 2, 2, 6, 1, 6, 6, 3, 6, 6, 4, 6, 6]], "expected": 6, "label": "another value has the longest run"},
    {"args": [[2, 2, 1, 1, 2, 1, 2, 2]], "expected": 2, "label": "even length, one more than half"},
    {"args": [[0, 1, 0, -1, 0]], "expected": 0, "label": "zero is the majority"},
    {"args": [[-5, 3, -5]], "expected": -5, "label": "negative majority"},
    {"args": [[1000000000, -1000000000, 1000000000]], "expected": 1000000000, "label": "extremes"},
    {"args": [[-1000000000, 1000000000, -1000000000, 1000000000, -1000000000]], "expected": -1000000000, "label": "extremes, negative majority"},
