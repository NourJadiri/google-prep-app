  "difficulty": "M",
  "lc": {"num": 152, "slug": "maximum-product-subarray"},
  "topics": ["dynamic programming", "array"],
  "kind": "function",
  "entry": "maxProduct",
  "params": [{"name": "nums"}],
  "starter": "class Solution:\n    def maxProduct(self, nums: List[int]) -> int:\n        pass\n",
  "tests": [
    {"args": [[2, -5, -2, -4, 3]], "expected": 24, "show": true},
    {"args": [[-1, -2, 0, 5, -1, -3]], "expected": 15, "show": true},
    {"args": [[-4]], "expected": -4, "show": true},
    {"args": [[7]], "expected": 7, "label": "one positive"},
    {"args": [[-10]], "expected": -10, "label": "one negative, the smallest allowed"},
    {"args": [[0]], "expected": 0, "label": "one zero"},
    {"args": [[-2, -3]], "expected": 6, "label": "two negatives"},
    {"args": [[-2, 0]], "expected": 0, "label": "a negative and a zero"},
    {"args": [[-1, -2, -3]], "expected": 6, "label": "three negatives"},
    {"args": [[-2, -3, -4, -5]], "expected": 120, "label": "four negatives"},
    {"args": [[0, 0, 0]], "expected": 0, "label": "all zeros"},
    {"args": [[-2, 0, -3]], "expected": 0, "label": "a zero between negatives"},
    {"args": [[1, 2, 3, 4]], "expected": 24, "label": "all positive"},
    {"args": [[1, 1, 1]], "expected": 1, "label": "all ones"},
    {"args": [[3, -1, 4]], "expected": 4, "label": "one negative between positives"},
    {"args": [[-5, 0, -3, 0, -1]], "expected": 0, "label": "negatives fenced off by zeros"},
    {"args": [[5, 5, -1, 2]], "expected": 25, "label": "best product is a prefix"},
    {"args": [[2, -1, 5, 5]], "expected": 25, "label": "best product is a suffix"},
    {"args": [[10, 10, 10, 10, 10, 10, 10, 10, 10]], "expected": 1000000000, "label": "the largest product allowed"},
    {"args": [[-10, 10, -10]], "expected": 1000, "label": "extreme values"},
    {"args": [[0, -1, 3, -1, -2, 1, -3, 1, -3, 0]], "expected": 54, "label": "random"},
    {"args": [[-2, 3, -2, 1, 1, -1, -1, -4, -4, -3, 3, -4, -4, -3, 3, 1, 3, 3, -3, 1, 1, 2, 4, 0, 4, 1, -1, -4, -4]], "expected": 26873856, "label": "random"},
    {"args": [[1, -1, 4, -4, -1, -4, -1, -1, -2, 0, -1, -4, 4, -3, 3]], "expected": 144, "label": "random"},
    {"args": [[-1, -1, 2, -4, 4, -4, 2, 3, -3, 0, 1]], "expected": 2304, "label": "random"},
    {"argsPy": "r = rng(1525)\nnums = []\nwhile len(nums) < 20000:\n    budget = 30\n    for _ in range(r.randint(1, 80)):\n        x = r.choice([-1, 1, -1, 1, -1, 1, -2, 2, -3, 3, -10, 10])\n        cost = {1: 0, 2: 1, 3: 2, 10: 4}[abs(x)]\n        if cost > budget:\n            x, cost = r.choice([-1, 1]), 0\n        budget -= cost\n        nums.append(x)\n    nums.append(0)\nargs = [nums[:20000]]", "expected": 110592000, "label": "large: 20,000 numbers with zeros", "perf": true},
    {"argsPy": "r = rng(1526)\nnums = [r.choice([-1, 1]) for _ in range(20000)]\nfor i in r.sample(range(20000), 30):\n    nums[i] = r.choice([-2, 2])\nargs = [nums]", "expected": 1073741824, "label": "large: 20,000 numbers, no zeros", "perf": true}
  ]
}
