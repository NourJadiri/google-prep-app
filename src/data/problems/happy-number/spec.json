    {"args": [145], "expected": false, "label": "145: already inside the loop"},
    {"args": [1111111], "expected": true, "label": "seven 1s: one step to 7"},
    {"args": [2111], "expected": true, "label": "2111: one step to 7"},
    {"args": [356], "expected": true, "label": "356: 6 steps to 1"},
    {"args": [2147483647], "expected": false, "label": "the largest input"},
    {"args": [1000000000], "expected": true, "label": "a billion"},
    {"args": [999999999], "expected": false, "label": "nine 9s"},
    {"args": [1385656125], "expected": true, "label": "random, large"},
