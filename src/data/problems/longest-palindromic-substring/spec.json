{
  "id": "longest-palindromic-substring",
  "title": "Longest Palindromic Substring",
  "difficulty": "M",
  "lc": {"num": 5, "slug": "longest-palindromic-substring"},
  "topics": ["string", "dynamic programming", "two pointers"],
  "kind": "function",
  "entry": "longestPalindrome",
  "params": [{"name": "s"}],
  "starter": "class Solution:\n    def longestPalindrome(self, s: str) -> str:\n        pass\n",
  "tests": [
    {"args": ["bananas"], "expected": "anana", "show": true},
    {"args": ["cabbad"], "expected": "abba", "show": true},
    {"args": ["pqrqpxyzyx"], "expected": "pqrqp", "show": true},
    {"args": ["a"], "expected": "a", "label": "one character"},
    {"args": ["zz"], "expected": "zz", "label": "two equal characters"},
    {"args": ["zq"], "expected": "z", "label": "two different characters: either one"},
    {"args": ["abcdedcba"], "expected": "abcdedcba", "label": "the whole string"},
    {"args": ["aaaa"], "expected": "aaaa", "label": "all the same, even length"},
    {"args": ["aaaaa"], "expected": "aaaaa", "label": "all the same, odd length"},
    {"args": ["Abcba"], "expected": "bcb", "label": "case matters: 'A' isn't 'a'"},
    {"args": ["1234321"], "expected": "1234321", "label": "digits"},
    {"args": ["xyz12321"], "expected": "12321", "label": "at the very end"},
    {"args": ["noonabc"], "expected": "noon", "label": "even length at the start"},
    {"args": ["aaabaaaa"], "expected": "aaabaaa", "label": "an uneven run around a centre"},
    {"args": ["abcdefg"], "expected": "a", "label": "no repeats: any single letter"},
    {"args": ["abababab"], "expected": "abababa", "label": "alternating: two answers"},
    {"args": ["qxyzzyxr"], "expected": "xyzzyx", "label": "even length in the middle"},
    {"args": ["abaxabaxabb"], "expected": "baxabaxab", "label": "overlapping candidates"},
    {"args": ["bbabaaaabbabaaaabbabaaabaaaaaa"], "expected": "abaaaba", "label": "random"},
    {"args": ["aabbacccaacabbabbaababbccacccbabbbbcbabbcaaba"], "expected": "abbabba", "label": "random"},
    {"args": ["bbabbbabaaaaabbbbbabbabaabbabbabbbaaabbaaabaabbbbaaabbaaabaa"], "expected": "baaabbaaab", "label": "random"},
    {"args": ["Bxjd2AsjD7N2kHD9FSUuErsEz5jhy0I9lO7F3vlfFrGYJ3GxeYYXwSLQcWtxJTQr1FqXSTs98vPlL2aEJXquQrDs0GPRZwwrPwV81Aw71l33SCx9vHjHkm1x"], "expected": "HjH", "label": "random"},
    {"args": ["yyzxzzzyxzzzzyyzzzyzxxxzyzzxxzxzzxyxxxxxyxyxzxyyyyzzxzxxzyxyyyyxzzyxzzyxyzzyzyyxyyzzzyyxxzyzyxxzxyzxyxyzzzxyzzyyyxyyyzyyxzzyzyyyyxyyyyxyxxzzyxyxxyxyzzyxyxxyyxzyyyzyzzzzxxxyyzzyzyzzxyyyzzzxxxyzyzxzzxxy"], "expected": "yxxyxyzzyxyxxy", "label": "random"},
    {"argsPy": "['a' * 1000]", "expected": "", "label": "large: one letter repeated", "perf": true},
    {"argsPy": "['a' * 499 + 'bc' + 'a' * 499]", "expected": "", "label": "large: \"bc\" between two runs of a's", "perf": true},
    {"argsPy": "r = rng(55)\nh = ''.join(r.choice(string.ascii_letters + string.digits) for _ in range(500))\nargs = [h + h[::-1]]", "expected": "", "label": "large: the whole string, even length", "perf": true},
    {"argsPy": "['ab' * 500]", "expected": "", "label": "large: alternating", "perf": true},
    {"argsPy": "r = rng(5005)\nargs = [''.join(r.choice('ab') for _ in range(1000))]", "expected": "aaaaabbbbbabbbbbaaaaa", "label": "large: random a/b", "perf": true}
  ]
}
