    {"argsPy": "r = rng(236)\nL, R = [], []\ndef node():\n    L.append(-1)\n    R.append(-1)\n    return len(L) - 1\ndef leg(k):\n    if k == 0:\n        return -1\n    u = node()\n    half = (k - 1) // 2\n    L[u] = leg(half)\n    R[u] = leg(k - 1 - half)\n    return u\nspine, prev = [], -1\nfor i in range(990):\n    u = node()\n    spine.append(u)\n    L[u] = leg(100)\n    if prev >= 0:\n        R[prev] = u\n    prev = u\nvals = list(range(1, len(L) + 1))\nr.shuffle(vals)\ndef deepest(u):\n    while L[u] >= 0:\n        u = L[u]\n    return u\nout, q = [], [0]\nfor u in q:\n    if u < 0:\n        out.append(None)\n        continue\n    out.append(vals[u])\n    q += [L[u], R[u]]\nwhile out[-1] is None:\n    out.pop()\nargs = [out, vals[deepest(L[spine[-1]])], vals[deepest(L[spine[-2]])]]", "label": "large: 100,000 nodes, the answer 989 levels down", "perf": true, "expected": 76023},
