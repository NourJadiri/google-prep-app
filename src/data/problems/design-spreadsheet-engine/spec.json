{
  "id": "design-spreadsheet-engine",
  "title": "Spreadsheet Engine",
  "difficulty": "H",
  "topics": ["design", "graph", "topological sort", "caching"],
  "kind": "design",
  "className": "Spreadsheet",
  "starter": "class Spreadsheet:\n\n    def __init__(self):\n        pass\n\n    def set(self, cell: str, value: int | str) -> bool:\n        pass\n\n    def get(self, cell: str) -> int:\n        pass\n",
