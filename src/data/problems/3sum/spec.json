  "starter": "class Solution:\n    def threeSum(self, nums: List[int]) -> List[List[int]]:\n        pass\n",
  "tests": [
    {"args": [[3, -1, -2, -1, 2, 0]], "expected": [[-2, -1, 3], [-2, 0, 2], [-1, -1, 2]], "show": true},
    {"args": [[-4, 2, 3]], "expected": [], "show": true},
    {"args": [[5, -5, 0, 0, 5, -5, 0]], "expected": [[-5, 0, 5], [0, 0, 0]], "show": true},
    {"args": [[1, -1, 0]], "expected": [[-1, 0, 1]], "label": "three numbers that work"},
    {"args": [[1, 2, 3]], "expected": [], "label": "three numbers that don't"},
    {"args": [[-1, -1, 2]], "expected": [[-1, -1, 2]], "label": "one value used twice"},
    {"args": [[2, 2, -4, -1, -1]], "expected": [[-4, 2, 2], [-1, -1, 2]], "label": "two triples, each repeating a value"},
    {"args": [[0, 0, 0, 0, 0, 0]], "expected": [[0, 0, 0]], "label": "all zeros"},
    {"args": [[0, 0, 1, -1]], "expected": [[-1, 0, 1]], "label": "two zeros aren't a triple"},
    {"args": [[-6, 3, 1]], "expected": [], "label": "can't reuse a position"},
    {"args": [[1, 2, 3, 4, 5]], "expected": [], "label": "all positive"},
    {"args": [[-1, -2, -3, -4]], "expected": [], "label": "all negative"},
    {"args": [[-2, 1, 1, -2, 1, 1]], "expected": [[-2, 1, 1]], "label": "the same triple many ways"},
    {"args": [[-1, -1, -1, 0, 0, 0, 1, 1, 1]], "expected": [[-1, 0, 1], [0, 0, 0]], "label": "every value three times"},
    {"args": [[-3, -2, -1, 0, 1, 2, 3]], "expected": [[-3, 0, 3], [-3, 1, 2], [-2, -1, 3], [-2, 0, 2], [-1, 0, 1]], "label": "triples sharing values"},
