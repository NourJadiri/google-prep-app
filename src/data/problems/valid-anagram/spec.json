{
  "id": "valid-anagram",
  "title": "Valid Anagram",
  "difficulty": "E",
  "lc": {"num": 242, "slug": "valid-anagram"},
  "topics": ["string", "hash map", "counting", "sorting"],
  "kind": "function",
  "entry": "isAnagram",
  "params": [{"name": "s"}, {"name": "t"}],
  "starter": "class Solution:\n    def isAnagram(self, s: str, t: str) -> bool:\n        pass\n",
  "tests": [
    {"args": ["night", "thing"], "expected": true, "show": true},
    {"args": ["aab", "abb"], "expected": false, "show": true},
    {"args": ["tea", "seat"], "expected": false, "show": true},
    {"args": ["a", "a"], "expected": true, "label": "one letter, the same"},
    {"args": ["a", "b"], "expected": false, "label": "one letter, different"},
    {"args": ["hello", "hello"], "expected": true, "label": "identical strings"},
    {"args": ["stressed", "desserts"], "expected": true, "label": "one is the other reversed"},
    {"args": ["ab", "ba"], "expected": true, "label": "two letters swapped"},
    {"args": ["abcd", "abc"], "expected": false, "label": "t is s with a letter missing"},
    {"args": ["abc", "abcd"], "expected": false, "label": "t is s with a letter extra"},
    {"args": ["aabb", "abbb"], "expected": false, "label": "same letters and length, different counts"},
    {"args": ["aaaa", "aaa"], "expected": false, "label": "one letter repeated, lengths differ"},
    {"args": ["zzzzzz", "zzzzzz"], "expected": true, "label": "all one letter"},
    {"args": ["abcdefghijklmnopqrstuvwxyz", "zyxwvutsrqponmlkjihgfedcba"], "expected": true, "label": "the whole alphabet, reversed"},
    {"args": ["dusty", "study"], "expected": true, "label": "anagram"},
    {"args": ["rail", "liar"], "expected": true, "label": "anagram"},
    {"args": ["cadeedefbabcebbefdaecdcbaaeddd", "dfeebaecacebbbdccadedefdeaddba"], "expected": true, "label": "random anagram"},
    {"args": ["iqhttoewtmirzsaryftrkjswbjzfkfnwvbadqstusxuylhfavmrqngupfmlv", "wygpmryblfkwurmohrvutaexvtfsvtfbsjzqandimunfltkatqisqfwzhrsj"], "expected": true, "label": "random anagram"},
    {"args": ["abbabbbeecdbbeecbcbadbbdaebabdedbdeadbab", "bbdebebbbbbdddbaaebabdcbadbbbecdeabeaebc"], "expected": false, "label": "random: same letters, one count off"},
    {"args": ["rsprpsqrqqqqrqqrqqqpqpqrq", "pqrrqqqqsqsrqppqqrqqprqpr"], "expected": false, "label": "random: same letters, one count off"},
    {"argsPy": "r = rng(2420)\ns = ''.join(r.choices(string.ascii_lowercase, k=5 * 10**4))\nt = list(s)\nr.shuffle(t)\nargs = [s, ''.join(t)]", "expected": true, "label": "large: 50,000 letters, an anagram", "perf": true},
    {"argsPy": "r = rng(2421)\ns = ''.join(r.choices(string.ascii_lowercase, k=5 * 10**4))\nt = list(s)\nr.shuffle(t)\ni = r.randrange(len(t))\nt[i] = 'a' if t[i] != 'a' else 'b'\nargs = [s, ''.join(t)]", "expected": false, "label": "large: 50,000 letters, one letter changed", "perf": true}
  ]
}
