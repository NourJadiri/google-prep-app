  "difficulty": "E",
  "lc": {"num": 643, "slug": "maximum-average-subarray-i"},
  "topics": ["array", "sliding window"],
  "kind": "function",
  "entry": "findMaxAverage",
  "params": [{"name": "nums"}, {"name": "k"}],
  "starter": "class Solution:\n    def findMaxAverage(self, nums: List[int], k: int) -> float:\n        pass\n",
  "tests": [
    {"args": [[4, -1, 7, 2, -5, 6], 2], "expected": 4.5, "show": true},
    {"args": [[-5, -1, -3, -8], 2], "expected": -2.0, "show": true},
    {"args": [[9, 0, 2, 1], 4], "expected": 3.0, "show": true},
    {"args": [[42], 1], "expected": 42.0, "label": "one element"},
    {"args": [[-10000], 1], "expected": -10000.0, "label": "one element, as small as allowed"},
    {"args": [[3, -2, 8, 1], 1], "expected": 8.0, "label": "k = 1: the largest element"},
    {"args": [[1, 2, 3, 4, 5], 5], "expected": 3.0, "label": "k = n: the whole list"},
    {"args": [[9, 8, 1, 1, 1, 1], 2], "expected": 8.5, "label": "best window at the start"},
    {"args": [[1, 1, 1, 1, 8, 9], 2], "expected": 8.5, "label": "best window at the end"},
    {"args": [[-3, 5, -2, 1, 0, 6, 7], 2], "expected": 6.5, "label": "the last window wins, after a dip"},
    {"args": [[4, 4, 4, 4], 3], "expected": 4.0, "label": "all equal"},
    {"args": [[0, 0, 0], 2], "expected": 0.0, "label": "all zeros"},
    {"args": [[-1, 0, -1, 0], 2], "expected": -0.5, "label": "negatives and zeros"},
    {"args": [[-7, -3, -9], 1], "expected": -3.0, "label": "all negative, k = 1"},
    {"args": [[-4, -6, -2, -8, -1, -9], 3], "expected": -3.6666666666666665, "label": "all negative, best window in the middle"},
    {"args": [[10000, 10000, 10000, -10000], 3], "expected": 10000.0, "label": "extremes"},
    {"args": [[1, 2, 2], 3], "expected": 1.6666666666666667, "label": "an average that doesn't come out even"},
    {"args": [[2, 7, -3, 4, 0, 5, -1], 4], "expected": 2.5, "label": "overlapping windows"},
    {"args": [[8042, 2705, 6831, 1174, 7168, -3496, -7047, -515, -1875, 1570], 3], "expected": 5859.333333333333, "label": "random"},
    {"args": [[-9520, 2308, -3633, 9094, 2230, 5018, -8584, 4499, -7055, 3576, 3089, -4002, 2772, -2782, -7932, -5554, 2059, -4486, -152, 7759, -8766, 9480, -1859, -4986, -7753], 7], "expected": 1561.7142857142858, "label": "random"},
    {"args": [[-9842, -975, -6061, -5054, -6981, -2393, -3583, -1618, -7403, -5937, -2633, -3878, -3206, -9476, -7804, -3582, -6292, -3785, -1300, -8854, -2574, -9013, -8963, -7114, -230, -658, -5326, -6911, -8990, -3494, -67, -5858, -9762, -2016, -4649, -8334, -197, -7613, -5256, -7680], 6], "expected": -3927.8333333333335, "label": "random, mostly negative"},
    {"args": [[690, 2406, -2440, -9620, 3015, -1720, -7440, -561, 4032, -5874, 4193, -6183, 5860, 5673, -2441, 7875, 8130, -9968, 3850, -6345, -1789, 8324, 3086, 8018, -8504, 7622, 3657, -196, -8735, 615, 6369, -7713, 5249, 8230, -8445, 4049, 3119, -2208, -1199, 3231, 5772, 214, 1945, 898, -9736, 8670, -1440, 2270, 9655, 4229, 7651, -7090, 817, 954, -189, 1020, -8828, 1536, -8047, 2816], 60], "expected": 483.81666666666666, "label": "random, k = n"},
    {"argsPy": "r = rng(6430)\nargs = [[r.randint(-10**4, 10**4) for _ in range(10**5)], 5 * 10**4]", "expected": 4.80064, "label": "large: n = 100,000, k = 50,000", "perf": true},
    {"argsPy": "r = rng(6431)\nargs = [[r.randint(-10**4, 0) for _ in range(10**5 - 5)] + [10**4] * 5, 5]", "expected": 10000.0, "label": "large: n = 100,000, k = 5, the best window is the very last one", "perf": true}
  ]
