{
  "id": "decode-ways",
  "title": "Decode Ways",
  "difficulty": "M",
  "lc": {"num": 91, "slug": "decode-ways"},
  "topics": ["dynamic programming", "string"],
  "kind": "function",
  "entry": "numDecodings",
  "params": [{"name": "s"}],
  "starter": "class Solution:\n    def numDecodings(self, s: str) -> int:\n        pass\n",
  "tests": [
    {"args": ["1215"], "expected": 5, "show": true},
    {"args": ["2030"], "expected": 0, "show": true},
    {"args": ["1101"], "expected": 1, "show": true},
    {"args": ["0"], "expected": 0, "label": "a lone zero"},
    {"args": ["7"], "expected": 1, "label": "one digit"},
    {"args": ["10"], "expected": 1, "label": "10 has to stay together"},
    {"args": ["27"], "expected": 1, "label": "27 is too big for one letter"},
    {"args": ["26"], "expected": 2, "label": "26 is the largest code"},
    {"args": ["30"], "expected": 0, "label": "30: the zero has no partner"},
    {"args": ["06"], "expected": 0, "label": "leading zero"},
    {"args": ["100"], "expected": 0, "label": "two zeros in a row"},
    {"args": ["106"], "expected": 1, "label": "a zero can't start a two-digit code"},
    {"args": ["2101"], "expected": 1, "label": "zeros bind to the digit before"},
    {"args": ["12120"], "expected": 3, "label": "the final zero takes the 2"},
    {"args": ["999"], "expected": 1, "label": "nothing pairs above 26"},
    {"args": ["1111111111"], "expected": 89, "label": "ten ones"},
    {"args": ["226226226"], "expected": 27, "label": "repeating 226"},
    {"args": ["9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999"], "expected": 1, "label": "100 digits, one decoding"},
    {"args": ["29322522116615"], "expected": 48, "label": "random"},
    {"args": ["551922129145732122761108"], "expected": 100, "label": "random"},
    {"args": ["7221224162177"], "expected": 78, "label": "random"},
    {"args": ["31769322314471222208818203"], "expected": 120, "label": "random"},
    {"args": ["11705287922111351213076181"], "expected": 0, "label": "random, undecodable"},
    {"argsPy": "['1' * 45]", "expected": 1836311903, "label": "large: 45 ones, the answer is a Fibonacci number", "perf": true},
    {"argsPy": "['1' * 98 + '00']", "expected": 0, "label": "large: a dead end after 98 ones", "perf": true},
    {"args": ["2741022266931113102714325121511332210110122164101111271944211133111273135863376922011823392331623101"], "expected": 1474560000, "label": "large: 100 digits, a ten-digit answer", "perf": true}
  ]
}
