    {"argsPy": "r = rng(1466)\nops, xs = ['LRUCache'], [[3000]]\nfor k in range(3000):\n    ops.append('put'); xs.append([k, r.randint(0, 10**5)])\nnew = 3000\nfor _ in range(147000):\n    x = r.random()\n    if x < 0.85:\n        ops.append('get'); xs.append([(new - 1 - r.randrange(6)) % 10001])\n    elif x < 0.95:\n        ops.append('put'); xs.append([(new - 1 - r.randrange(30)) % 10001, r.randint(0, 10**5)])\n    elif x < 0.99:\n        ops.append('put'); xs.append([new % 10001, r.randint(0, 10**5)]); new += 1\n    else:\n        ops.append('get'); xs.append([(new + 5000 + r.randrange(1000)) % 10001])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 150,000 calls, capacity 3,000, the newest keys reused over and over", "perf": true},
    {"argsPy": "r = rng(1467)\nops, xs = ['LRUCache'], [[3000]]\nfor k in range(3000):\n    ops.append('put'); xs.append([k, r.randint(0, 10**5)])\nnew = 3000\nfor _ in range(47000):\n    x = r.random()\n    if x < 0.5:\n        ops.append('put'); xs.append([new % 10001, r.randint(0, 10**5)]); new += 1\n    elif x < 0.8:\n        ops.append('get'); xs.append([(new - 1 - r.randrange(3500)) % 10001])\n    else:\n        ops.append('get'); xs.append([(new - 1 - r.randrange(10)) % 10001])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 50,000 calls, capacity 3,000, a steady stream of new keys", "perf": true}
