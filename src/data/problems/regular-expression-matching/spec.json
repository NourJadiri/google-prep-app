{
  "id": "regular-expression-matching",
  "title": "Regular Expression Matching",
  "difficulty": "H",
  "lc": {"num": 10, "slug": "regular-expression-matching"},
  "topics": ["dynamic programming", "string", "recursion"],
  "kind": "function",
  "entry": "isMatch",
  "params": [{"name": "s"}, {"name": "p"}],
  "starter": "class Solution:\n    def isMatch(self, s: str, p: str) -> bool:\n        pass\n",
  "tests": [
    {"args": ["abbbc", "ab*c"], "expected": true, "show": true},
    {"args": ["ac", "ab*c"], "expected": true, "show": true},
    {"args": ["abcd", "a.c"], "expected": false, "show": true},
    {"args": ["a", "a"], "expected": true, "label": "one letter"},
    {"args": ["a", "b"], "expected": false, "label": "different letters"},
    {"args": ["a", "."], "expected": true, "label": "a dot matches any letter"},
    {"args": ["a", ".*"], "expected": true, "label": "dot-star matches anything"},
    {"args": ["a", "b*"], "expected": false, "label": "b* can only match nothing"},
    {"args": ["a", "b*a"], "expected": true, "label": "skip the star element"},
    {"args": ["a", "ab*"], "expected": true, "label": "a trailing star element matches nothing"},
    {"args": ["aaa", "a*a"], "expected": true, "label": "the star has to give one back"},
    {"args": ["aaa", "a*aaaa"], "expected": false, "label": "the pattern needs more a's than there are"},
    {"args": ["ab", ".*c"], "expected": false, "label": "dot-star can't produce a c"},
    {"args": ["ab", "a*b*"], "expected": true, "label": "two star elements"},
    {"args": ["ba", "a*b*"], "expected": false, "label": "order still matters"},
    {"args": ["abcd", "a.*d"], "expected": true, "label": "dot-star in the middle"},
    {"args": ["a", "a*a*a*a*"], "expected": true, "label": "many star elements, one letter"},
    {"args": ["ab", ".*.."], "expected": true, "label": "dot-star then two dots"},
    {"args": ["a", ".*.."], "expected": false, "label": "one letter is too short for two dots"},
    {"args": ["zzzzzzzzzzzzzzzzzzzz", ".*"], "expected": true, "label": "20 letters against dot-star"},
    {"args": ["abcdefghijklmnopqrst", "abcdefghijklmnopqrst"], "expected": true, "label": "20 literal letters"},
    {"args": ["aab", "b*a*.b"], "expected": true, "label": "star element before a dot"},
    {"args": ["babbabbbbaba", "bab.ab*.a*a"], "expected": false, "label": "random"},
    {"args": ["bcabaaab", ".b.*a*b"], "expected": false, "label": "random"},
    {"args": ["bacaaacaabbac", "b.*aaa*cb*a*b..*"], "expected": true, "label": "random"},
    {"args": ["bbbaaaabbb", "bb*aa*b*"], "expected": true, "label": "random"},
    {"args": ["bcaaccababbaaa", "bc.*..*c..*.a*"], "expected": true, "label": "random"},
    {"args": ["cbccabaaaca", "..*c.b.ac*ca"], "expected": false, "label": "random"},
    {"args": ["aaaaaaaaaaaaaaaaaaab", "a*a*a*a*a*a*a*a*a*a*"], "expected": false, "label": "large: ten a* against a stray b", "perf": true},
    {"args": ["aaaaaaaaaaaaaaaaaaaa", "a*a*a*a*a*a*a*a*a*b"], "expected": false, "label": "large: nine a* before a missing b", "perf": true},
    {"args": ["abababababababababab", ".*.*.*.*.*.*.*.*.*c"], "expected": false, "label": "large: nine dot-stars before a missing c", "perf": true}
  ]
}
