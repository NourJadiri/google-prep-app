{
  "id": "longest-common-prefix",
  "title": "Longest Common Prefix",
  "difficulty": "E",
  "lc": {"num": 14, "slug": "longest-common-prefix"},
  "topics": ["string", "array"],
  "kind": "function",
  "entry": "longestCommonPrefix",
  "params": [{"name": "strs"}],
  "starter": "class Solution:\n    def longestCommonPrefix(self, strs: List[str]) -> str:\n        pass\n",
  "tests": [
    {"args": [["interview", "internet", "interval"]], "expected": "inter", "show": true},
    {"args": [["cart", "car", "carbon"]], "expected": "car", "show": true},
    {"args": [["apple", "banana", "apricot"]], "expected": "", "show": true},
    {"args": [["alone"]], "expected": "alone", "label": "one string"},
    {"args": [[""]], "expected": "", "label": "one empty string"},
    {"args": [["abc", "", "abd"]], "expected": "", "label": "an empty string in the middle"},
    {"args": [["same", "same", "same"]], "expected": "same", "label": "all identical"},
    {"args": [["a", "b"]], "expected": "", "label": "two single letters, different"},
    {"args": [["abc", "abd", "xbc"]], "expected": "", "label": "only the last string differs at the start"},
    {"args": [["abcd", "abxd", "abcf"]], "expected": "ab", "label": "the middle string ends it early"},
    {"args": [["international", "inter", "in"]], "expected": "in", "label": "the shortest string comes last"},
    {"args": [["a", "ab", "abc"]], "expected": "a", "label": "the shortest string comes first"},
    {"args": [["ab", "a"]], "expected": "a", "label": "the first string is the longer one"},
    {"args": [["prefix", "prefixes", "prefixed", "prefixing"]], "expected": "prefix", "label": "the answer is a whole word"},
    {"args": [["zz", "zz", ""]], "expected": "", "label": "an empty string last"},
    {"args": [["ab", "ab", "ab", "ac"]], "expected": "a", "label": "one letter in common"},
    {"args": [["acccabcb", "accca", "accbbbcb", "accaba", "accbb", "acccc"]], "expected": "acc", "label": "random"},
    {"args": [["aabaa", "aabaa", "aabaabaab", "aabaab", "aabaabaa", "aabaabaab", "aabaaabba", "aabaabba", "aabaa", "aabaa"]], "expected": "aabaa", "label": "random"},
    {"args": [["bba", "bbba", "bbabbabb", "bbbbb", "bbabbb"]], "expected": "bb", "label": "random"},
    {"args": [["xyzyxzxyyzyxz", "xyzyxzxyyxy", "xyzyxzxyzyyyy", "xyzyxzxyzx", "xyzyxzxy", "xyzyxzxyzyyxy", "xyzyxzxy", "xyzyxzxy", "xyzyxzxyy", "xyzyxzxy", "xyzyxzxy", "xyzyxzxyzyzy", "xyzyxzxyxx", "xyzyxzxyx", "xyzyxzxy", "xyzyxzxyy", "xyzyxzxyzyxxxz", "xyzyxzxyyyzyx", "xyzyxzxyzzxz", "xyzyxzxyxyyyx", "xyzyxzxyzzy", "xyzyxzxyzxx", "xyzyxzxyyyyxy", "xyzyxzxyxxxxzx", "xyzyxzxyy"]], "expected": "xyzyxzxy", "label": "random"},
    {"argsPy": "w = 'qwertyuiopasdfghjklzxcvbnm' * 8\nargs = [[w[:200]] * 199 + ['']]", "expected": "", "label": "200 strings, the last one empty"},
    {"argsPy": "r = rng(140)\nw = ''.join(r.choices(string.ascii_lowercase, k=200))\nargs = [[w] * 200]", "expected": "ucgnbsaesvkzxfevsxbokmsrdwrtpryumfgdncmdvjvwwzmrpykqtryigfjpjvewvkimdzeeorgcaqrgjiojhkttyvldohzrgpzxrruxckdgjnlrpgkwltzykydujinyntgwbcdcejxfvwrakusrworqzpawjqnvkqlnmtkerbuwinmaupwpghhmecreebstjmjwwubw", "label": "largest: 200 identical strings of 200 letters", "perf": true},
    {"argsPy": "r = rng(141)\nw = ''.join(r.choices(string.ascii_lowercase, k=199))\nargs = [[w + 'a'] * 199 + [w + 'b']]", "expected": "nauesagorxkgjtvetjftgoghevutronqlchiqvmkjorngvbiagpqiiprbsmlneodrzqjvxvqihyjhriyperpcoubzwkzyaapgnghdglfawmzorkezgemvhhczzsodwoqheieqletvrjvvfselvxndmdxuzkobaccrmnhajedujtbollfpxumnwwdesxpglxokfgwvni", "label": "largest: the last string differs at its last letter", "perf": true}
  ]
}
