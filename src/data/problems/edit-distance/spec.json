{
  "id": "edit-distance",
  "title": "Edit Distance",
  "difficulty": "M",
  "lc": {"num": 72, "slug": "edit-distance"},
  "topics": ["dynamic programming", "string"],
  "kind": "function",
  "entry": "minDistance",
  "params": [{"name": "word1"}, {"name": "word2"}],
  "starter": "class Solution:\n    def minDistance(self, word1: str, word2: str) -> int:\n        pass\n",
  "tests": [
    {"args": ["tuesday", "thursday"], "expected": 2, "show": true},
    {"args": ["garden", "pardon"], "expected": 2, "show": true},
    {"args": ["", "abc"], "expected": 3, "show": true},
    {"args": ["", ""], "expected": 0, "label": "both empty"},
    {"args": ["abc", ""], "expected": 3, "label": "delete everything"},
    {"args": ["a", "b"], "expected": 1, "label": "one replacement"},
    {"args": ["abc", "abc"], "expected": 0, "label": "identical"},
    {"args": ["abc", "xyz"], "expected": 3, "label": "nothing in common"},
    {"args": ["abc", "abcdef"], "expected": 3, "label": "word1 is a prefix of word2"},
    {"args": ["abcdef", "def"], "expected": 3, "label": "word2 is a suffix of word1"},
    {"args": ["ab", "ba"], "expected": 2, "label": "two letters swapped"},
    {"args": ["abcd", "dcba"], "expected": 4, "label": "reversed"},
    {"args": ["aaaa", "aa"], "expected": 2, "label": "repeated letters"},
    {"args": ["kayak", "yak"], "expected": 2, "label": "delete from the front"},
    {"args": ["algorithm", "altruistic"], "expected": 6, "label": "longer words"},
    {"args": ["", ""], "expected": 500, "label": "500 deletions"},
    {"args": ["aabbbababaaa", "bababababbbbbab"], "expected": 7, "label": "random"},
    {"args": ["bcabcbcabbcbabaaabbabaaba", "bbaccbcbaabccabbbbaa"], "expected": 11, "label": "random"},
    {"args": ["cccbbcbadaadbacbbacdbcbadbdaccdbcadbddac", "abdcdabcacabadaaacccaababcdaacbbaabca"], "expected": 25, "label": "random"},
    {"args": ["xvrkcrveovcuhuwodndrnrwszqzvjt", "njlxexfnddsiqpiexujqwvrttupyywhqxauvczeomkkbw"], "expected": 40, "label": "random"},
    {"args": ["npgvwcjrailkqxbhsmnuiiyeqqxexyqxmdokpexf", "npgvwcjrailkqxbhfmnuiiyepqxxyqxmdqoukpexf"], "expected": 5, "label": "random: a few edits apart"},
    {"argsPy": "r = rng(7200)\nL = string.ascii_lowercase\nargs = [''.join(r.choice(L) for _ in range(500)), ''.join(r.choice(L) for _ in range(500))]", "expected": 446, "label": "large: two random 500-letter words", "perf": true},
    {"argsPy": "r = rng(7201)\nargs = [''.join(r.choice('ab') for _ in range(500)), ''.join(r.choice('ab') for _ in range(500))]", "expected": 153, "label": "large: 500 letters over a and b", "perf": true},
    {"argsPy": "r = rng(7202)\nw = [r.choice('abcdefgh') for _ in range(500)]\nv = list(w)\nfor _ in range(40):\n    k = r.randrange(len(v))\n    v[k] = r.choice('abcdefgh')\ndel v[100:110]\nv[300:300] = list('zzzzzzzzzz')\nargs = [''.join(w), ''.join(v)]", "expected": 52, "label": "large: near-copies, 500 letters", "perf": true}
  ]
}
