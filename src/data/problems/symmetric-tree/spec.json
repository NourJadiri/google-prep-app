{
  "id": "symmetric-tree",
  "title": "Symmetric Tree",
  "difficulty": "E",
  "lc": {"num": 101, "slug": "symmetric-tree"},
  "topics": ["binary tree", "recursion"],
  "kind": "function",
  "entry": "isSymmetric",
  "params": [{"name": "root", "type": "TreeNode"}],
  "starter": "# class TreeNode:\n#     def __init__(self, val=0, left=None, right=None):\n#         self.val = val\n#         self.left = left\n#         self.right = right\n\nclass Solution:\n    def isSymmetric(self, root: Optional[TreeNode]) -> bool:\n        pass\n",
  "tests": [
    {"args": [[4, 6, 6, 1, 3, 3, 1]], "expected": true, "show": true},
    {"args": [[5, 1, 1, 2, null, 2]], "expected": false, "show": true},
    {"args": [[7]], "expected": true, "show": true},
    {"args": [[1, 2, 2]], "expected": true, "label": "two equal children"},
    {"args": [[1, 2, 3]], "expected": false, "label": "two different children"},
    {"args": [[1, 2]], "expected": false, "label": "only a left child"},
    {"args": [[3, 4, 4, 5, 6, 5, 6]], "expected": false, "label": "identical sides, not mirrored"},
