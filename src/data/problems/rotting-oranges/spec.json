    {"argsPy": "r = rng(994)\ng = [[0] * 300 for _ in range(300)]\nfor k in range(50):\n    top = 6 * k\n    cells = []\n    for i, row in enumerate((top, top + 2, top + 4)):\n        cols = range(300) if i % 2 == 0 else range(299, -1, -1)\n        cells += [(row, c) for c in cols]\n        if i < 2:\n            cells.append((row + 1, 299 if i % 2 == 0 else 0))\n    for x, y in cells:\n        g[x][y] = 1\n    x, y = cells[r.randrange(len(cells))] if k else cells[0]\n    g[x][y] = 2\nargs = [g]", "expected": 901, "label": "300 x 300: fifty winding rows, ~900 minutes", "perf": true},
    {"argsPy": "r = rng(9940)\nargs = [[[0 if i % 30 == 29 or j % 30 == 29 else (2 if r.random() < 0.2 else 1) for j in range(300)] for i in range(300)]]", "expected": 6, "label": "300 x 300: a hundred crates, thousands of rotten oranges", "perf": true}
  ]
