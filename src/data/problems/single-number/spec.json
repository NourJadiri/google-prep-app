{
  "id": "single-number",
  "title": "Single Number",
  "difficulty": "E",
  "lc": {"num": 136, "slug": "single-number"},
  "topics": ["array", "bit manipulation"],
  "kind": "function",
  "entry": "singleNumber",
  "params": [{"name": "nums"}],
  "starter": "class Solution:\n    def singleNumber(self, nums: List[int]) -> int:\n        pass\n",
  "tests": [
    {"args": [[7, 3, 5, 3, 7]], "expected": 5, "show": true},
    {"args": [[-2, 9, 9]], "expected": -2, "show": true},
    {"args": [[6]], "expected": 6, "show": true},
    {"args": [[0]], "expected": 0, "label": "a single zero"},
    {"args": [[0, 1, 1]], "expected": 0, "label": "the answer is zero"},
    {"args": [[5, 5, 8]], "expected": 8, "label": "the single number comes last"},
    {"args": [[8, 5, 5]], "expected": 8, "label": "the single number comes first"},
    {"args": [[1, 1, 2, 2, 3]], "expected": 3, "label": "sorted, the single number is the largest"},
    {"args": [[1, 2, 2, 3, 3]], "expected": 1, "label": "sorted, the single number is the smallest"},
    {"args": [[3, 3, 2, 1, 1]], "expected": 2, "label": "reverse sorted, single in the middle"},
    {"args": [[-1, -1, -2]], "expected": -2, "label": "all negative"},
    {"args": [[-7, 7, 7]], "expected": -7, "label": "a number and its negative"},
    {"args": [[30000, -30000, 30000]], "expected": -30000, "label": "extremes"},
    {"args": [[-30000, 30000, -30000]], "expected": 30000, "label": "extremes, the other way"},
    {"args": [[2, 9, 2, 9, 4]], "expected": 4, "label": "pairs split up"},
    {"args": [[10, 10, 20, 20, 30, 30, 40]], "expected": 40, "label": "pairs side by side"},
    {"args": [[-84, 79, 36, 10, 48, 48, 9, -48, 96, -48, 36, 11, 79, 11, -84, 96, 9, -64, 10, 27, 27]], "expected": -64, "label": "random"},
    {"args": [[-92, 71, -47, 40, 38, 95, 64, 51, -20, -74, 65, -33, -92, 9, 65, 96, 48, 39, 48, -54, -20, 91, -54, 38, 1, -34, 74, 64, -33, 39, -34, -35, 95, -83, -83, -16, -89, 91, -89, 40, 74, 31, -47, -35, 1, 31, -74, 9, 71, -16, 96]], "expected": 51, "label": "random"},
    {"args": [[5112, -5185, -1447, -18030, 7419, -6268, -5185, 2330, 23801, 12102, -12703, 8055, -26791, -24408, 9944, -26791, 24792, -26355, 29665, 12102, 7419, -3077, -730, -1447, -24834, -23344, 27147, -16909, 5112, -14991, -2543, 24192, 16448, 27147, -12703, 17820, -18030, -22396, 29663, -730, 23801, 9944, 24192, 28425, 12961, 23982, -26355, -2543, 10456, 23982, 8351, -11769, -17549, -16909, 24792, 16448, -11769, 22196, -23344, 5831, -17549, 12961, 2330, 8351, -6268, -24408, -1834, -22396, 22196, -3077, 17820, -1834, 28425, -24834, 5831, 8055, 10456, 29663, 29665, -27898, -14991]], "expected": -27898, "label": "random"},
    {"argsPy": "r = rng(1360)\nvals = r.sample(range(-3 * 10**4, 3 * 10**4 + 1), 15000)\nsingle = vals.pop()\nxs = vals * 2\nr.shuffle(xs)\nargs = [xs + [single]]", "expected": -29399, "label": "large: 29,999 numbers, the single one last", "perf": true},
    {"argsPy": "xs = []\nfor v in range(1, 15000):\n    xs += [v, v]\nxs.insert(14999, -30000)\nargs = [xs]", "expected": -30000, "label": "large: pairs side by side, the single one in the middle", "perf": true}
  ]
}
