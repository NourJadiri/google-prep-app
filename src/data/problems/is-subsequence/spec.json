{
  "id": "is-subsequence",
  "title": "Is Subsequence",
  "difficulty": "E",
  "lc": {"num": 392, "slug": "is-subsequence"},
  "topics": ["string", "two pointers"],
  "kind": "function",
  "entry": "isSubsequence",
  "params": [{"name": "s"}, {"name": "t"}],
  "starter": "class Solution:\n    def isSubsequence(self, s: str, t: str) -> bool:\n        pass\n",
  "tests": [
    {"args": ["pin", "pigeon"], "expected": true, "show": true},
    {"args": ["dog", "dragon"], "expected": false, "show": true},
    {"args": ["", "abc"], "expected": true, "show": true},
    {"args": ["", ""], "expected": true, "label": "both empty"},
    {"args": ["a", ""], "expected": false, "label": "t is empty"},
    {"args": ["a", "a"], "expected": true, "label": "one letter each, equal"},
    {"args": ["abc", "abc"], "expected": true, "label": "equal strings"},
    {"args": ["abcd", "abc"], "expected": false, "label": "s longer than t"},
    {"args": ["z", "abcdef"], "expected": false, "label": "a letter t doesn't have"},
    {"args": ["ab", "ba"], "expected": false, "label": "right letters, wrong order"},
    {"args": ["aa", "a"], "expected": false, "label": "repeated letter, t has only one"},
    {"args": ["boot", "robot"], "expected": false, "label": "repeated letter needs two matches"},
    {"args": ["aaa", "banana"], "expected": true, "label": "repeated letter, t has enough"},
    {"args": ["q", "aaaaq"], "expected": true, "label": "one letter, found at the end"},
    {"args": ["xyz", "aaaaaaaaaaaaaaaaaaaaxyz"], "expected": true, "label": "s matches only at the very end"},
    {"args": ["abc", "abczzzzz"], "expected": true, "label": "s matches t's first letters"},
    {"args": ["abcz", "abcxyy"], "expected": false, "label": "all but the last letter match"},
    {"args": ["sea", "season"], "expected": true, "label": "matched as a block"},
    {"args": ["bcebcbbbacedbdacabcbdadcd", "eddebdbcbeacbcebaabdaccceaaaabbdbbebabcaaccabbaceedebdeaaacebbadbdcecaddaddebdbceebbccabccccbbeedaeabccceaccedcedcecaabd"], "expected": true, "label": "random, true"},
    {"args": ["gvsqjwotnicnxhlfyxixcwrxdsrqytjodymkwrxlqhoqbmdmelpkufrbkmsm", ""], "expected": true, "label": "random, true"},
    {"args": ["pmpmmmopoppmpnopnopmonpppmnmmpppnnnpmmppmmmoopnnopommnpnnpnmmnpnpmmpnnnopnmmmnnopnmnmmommomopnmnoonp", ""], "expected": true, "label": "random, true, s at the maximum length"},
    {"args": ["xyxyyxyyxyxx", "yyxyxyxxxyyxyyxxxxxyyxxyyxxxxxxyxyyyxyyxyxyxxxyyxyyyyxyyyxyx"], "expected": true, "label": "random, two letters"},
    {"args": ["zdrbrvqehyxbecqcoeqv", ""], "expected": false, "label": "random, false"},
    {"args": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbaaabbaacccbbccabbaaaabbcaacbabcaccaaccbccacccaaccbcbcbacabbccccbacbababaaacaaababbcaacccbcaacacaabcccbbbbccaabaccbbccccbcbaccbcbcbaabccbaccbabccbaabaaccabccccbbccabaabaabcbbaaaccccabcbbbaccababbcbcc"], "expected": false, "label": "random: one more 'a' than t has"},
    {"argsPy": "['b' * 100, ('a' * 99 + 'b') * 100]", "expected": true, "label": "large: every match is 100 letters apart, the last one at the very end", "perf": true},
    {"argsPy": "['ab' * 49 + 'c', 'ab' * 5000]", "expected": false, "label": "large: the last letter never comes", "perf": true}
  ]
}
