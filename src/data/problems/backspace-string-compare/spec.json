  "id": "backspace-string-compare",
  "title": "Backspace String Compare",
  "difficulty": "E",
  "lc": {"num": 844, "slug": "backspace-string-compare"},
  "topics": ["two pointers", "stack", "string"],
  "kind": "function",
  "entry": "backspaceCompare",
  "params": [{"name": "s"}, {"name": "t"}],
  "starter": "class Solution:\n    def backspaceCompare(self, s: str, t: str) -> bool:\n        pass\n",
  "tests": [
    {"args": ["abc#d", "abzz##d"], "expected": true, "show": true},
    {"args": ["x#y#", "#"], "expected": true, "show": true},
    {"args": ["bxj##tw", "bxj###tw"], "expected": false, "show": true},
    {"args": ["a", "a"], "expected": true, "label": "one letter each, the same"},
    {"args": ["a", "b"], "expected": false, "label": "one letter each, different"},
    {"args": ["#", "z#"], "expected": true, "label": "a backspace on an empty box vs a deleted letter"},
    {"args": ["q##w", "w"], "expected": true, "label": "more backspaces than letters, then a letter"},
    {"args": ["ab", "b"], "expected": false, "label": "one text is the end of the other"},
    {"args": ["k", "kk#k"], "expected": false, "label": "one text is the end of the other, after a backspace"},
    {"args": ["xyz", "xyw"], "expected": false, "label": "differ only in the last letter"},
    {"args": ["qxyz", "pxyz"], "expected": false, "label": "differ only in the first letter"},
    {"args": ["mnop####z", "z"], "expected": true, "label": "everything before the last letter erased"},
    {"args": ["abc###", "z#"], "expected": true, "label": "both erase to nothing"},
    {"args": ["a#b#c#", "d"], "expected": false, "label": "nothing vs one letter"},
    {"args": ["abc#", "abd#"], "expected": true, "label": "different letters, both deleted"},
    {"args": ["ab#cd#e", "ace"], "expected": true, "label": "backspaces on one side only"},
    {"args": ["hello", "hello"], "expected": true, "label": "no backspaces at all"},
    {"args": ["a##", "#a#"], "expected": true, "label": "backspaces before and after"},
    {"args": ["aba###abba###abbbbb#", "ab#ab#bab##bb#bbb#"], "expected": true, "label": "random, same final text"},
    {"args": ["baa##aaba#aabb###ab#bba##ba", "bb##baabaab#babb###babb###aa#"], "expected": true, "label": "random, same final text"},
    {"args": ["bbab###aabb##abbbbaa##abab###aba", "b#bba##aaaaa##bba#baa##baaba"], "expected": true, "label": "random, same final text"},
    {"args": ["ba#bbbabbaa###aba##", "bb##bbaa###abaab###ba#abbb##abba###"], "expected": false, "label": "random, one letter differs"},
    {"args": ["aaa##bba##aaba###abbb##bb#abab", "abaabb##baaba##bab"], "expected": false, "label": "random, one letter differs"},
    {"args": ["ba#a#a##aa#ba#a", "#a#b#b#ba#"], "expected": false, "label": "random, lots of backspaces"},
    {"args": ["a########abb", "#abbba###bbb#a#"], "expected": false, "label": "random, lots of backspaces"},
    {"args": ["pphwu###ewk##byoie###xlepj###lfs##gcq##stpqu###pevz###rxacw###hxngl###azedxn##vecz###zhkn##tkt#hccsqzkr###tc#mf#llps##bjmjjqvj###ixajhecf##or#hrdt#ng#tmg#blww###ke#br#onxxp##re#yhp##wiiof##pvek#rdwux#", "rsq###ppebggz###yq#xlwmj###lgsyd##tpkc##rxhxg##xsjm###azjqr###edvzhtke#hcqi##ck#su#qtucw###mllbjpxw###mq#jjc#is#xc#ajjif###hr#exmz###ohry#dntstr###mboo##kah##bm#onxrya#wwop###iytf###ipverew##dwu#uo#g#"], "expected": true, "label": "200 characters each, same final text"},
    {"args": ["pphwu###ewk##byoie###xlepj###lfs##gcq##stpqu###pevz###rxacw###hxngl###azedxn##vecz###zhkn##tkt#hccsqzkr###tc#mf#llps##bjmjjqvj###ixajhecf##or#hrdt#ng#tmg#blww###ke#br#onxxp##re#yhp##wiiof##pvek#rdwux#", "############t#zpebgew###yxllqpl###gstpp#rm#xu#hxmg##atn##zem#dvzhtcie###kxog###hfi##ccsbt##qtnql###mfd##ln#lbw#jjy##mjjn#ilii###xbt##apmx###jheohj#rdgdb###nbn##tmbkaz##bu#onmls###xrywiipves#rdwip##uj#"], "expected": false, "label": "200 characters each, first surviving letter differs"}
  ]
