{
  "id": "longest-substring-k-distinct",
  "title": "Longest Substring with At Most K Distinct Characters",
  "difficulty": "M",
  "lc": {"num": 340, "premium": true},
  "topics": ["sliding window", "hash map", "string"],
  "kind": "function",
  "entry": "lengthOfLongestSubstringKDistinct",
  "params": [{"name": "s"}, {"name": "k"}],
  "starter": "class Solution:\n    def lengthOfLongestSubstringKDistinct(self, s: str, k: int) -> int:\n        pass\n",
  "tests": [
    {"args": ["acacab", 2], "expected": 5, "show": true},
    {"args": ["xyz", 1], "expected": 1, "show": true},
    {"args": ["aabbcc", 2], "expected": 4, "show": true},
    {"args": ["aaaa", 3], "expected": 4, "show": true},
    {"args": ["abc", 0], "expected": 0, "label": "k = 0"},
    {"args": ["q", 0], "expected": 0, "label": "one character, k = 0"},
    {"args": ["q", 1], "expected": 1, "label": "one character"},
    {"args": ["abcabc", 50], "expected": 6, "label": "k bigger than the number of distinct characters"},
    {"args": ["abcabc", 3], "expected": 6, "label": "k exactly the number of distinct characters"},
    {"args": ["aaaabcd", 1], "expected": 4, "label": "best window at the start"},
    {"args": ["xyzzzzz", 1], "expected": 5, "label": "best window at the end"},
    {"args": ["aaabbbccc", 2], "expected": 6, "label": "the left edge has to jump several places"},
    {"args": ["abababab", 1], "expected": 1, "label": "alternating, k = 1"},
    {"args": ["abababab", 2], "expected": 8, "label": "alternating, k = 2"},
    {"args": ["aAaAbB", 1], "expected": 1, "label": "case matters"},
    {"args": ["aAaAbB", 2], "expected": 4, "label": "case matters, k = 2"},
    {"args": ["a b a,b  b,a", 3], "expected": 6, "label": "spaces and punctuation are characters too"},
    {"args": ["1122334411", 2], "expected": 4, "label": "digits"},
    {"args": ["eeceebaebbbe", 2], "expected": 5, "label": "a window that shrinks and regrows"},
    {"args": ["bcaccacbabacccbbacbabbcaaaaabb", 2], "expected": 7, "label": "random"},
    {"args": ["bbcbdbccbdebeebbabbaebdbdecabdadcabcdbecadadadddaabbdbdcdbee", 3], "expected": 15, "label": "random"},
    {"args": ["dbefceagaacgabhdbkdfaejidccbgcbkaakbkgakdhaflijegilacjibheckdfcidjkjjlfighdedhaklhlklfeacgkakhjkcagablihhbbhlfceliakkcdlledlihkcbdlidlljglbkabfdgdcfbidahafjegeldafjbdcbjigcgadellfegcjdjciabhkjhibkfdhc", 5], "expected": 15, "label": "random"},
    {"args": ["", 20], "expected": 33, "label": "random"},
    {"argsPy": "r = rng(3400)\nalpha = [chr(c) for c in range(33, 127)]\nargs = [''.join(alpha[(i // 500 + r.randrange(5)) % 94] for i in range(50000)), 10]", "expected": 3044, "label": "large: a slowly drifting alphabet, k = 10", "perf": true},
    {"argsPy": "['m' * 50000, 1]", "expected": 50000, "label": "large: one character repeated 50,000 times", "perf": true},
    {"argsPy": "r = rng(3401)\nletters = [chr(c) for c in range(65, 91)] + [chr(c) for c in range(97, 123)]\na, b = letters[:50], letters[2:]\nargs = [''.join(r.choice(a) for _ in range(24000)) + '!' + ''.join(r.choice(b) for _ in range(25999)), 50]", "expected": 25999, "label": "large: k = 50, two long windows", "perf": true}
  ]
}
