    {"args": [[["r", "k", "y", "e", "x", "k"], ["e", "j", "n", "i", "s", "b"], ["x", "q", "y", "z", "i", "u"], ["l", "z", "w", "s", "y", "d"], ["l", "a", "q", "a", "d", "x"], ["p", "l", "x", "a", "k", "v"]], ["jsuwyccfqe", "gz", "kb", "sizsw", "yl", "mj", "fbjofwzzj", "psh", "wzlxejny", "ifubovrr", "eoxukjb", "wop", "dkaaqazl", "b", "ydkvxd", "plallzwq", "kqpybnvjk", "k", "rejqzwqa", "e", "gygtdcl", "mcaupsegx", "omdasr", "tczkygtrg", "nviiwqlq", "ffei", "kxeipifgoo", "lplxqwszi", "mkmlicat", "xdubsiny", "el", "dcmsy", "wq", "tbbmnali", "dxdaqxak", "zzye", "zer", "sizinjkye", "jrytbgkow", "yslcbwgnh", "jx", "iqha", "elnqeunh", "kaxl", "wjsazg", "g", "cwpyfv", "ptlis", "kbsiydxvk", "xqzaqw", "p", "krexlzaq", "iziu", "fje", "mchtrjlso", "kxeisbu", "oekgsapo", "nytdp", "myncbd", "itseez"]], "label": "random", "expected": ["b", "dkaaqazl", "dxdaqxak", "e", "iziu", "k", "kaxl", "kb", "kbsiydxvk", "krexlzaq", "kxeisbu", "lplxqwszi", "p", "plallzwq", "rejqzwqa", "sizinjkye", "sizsw", "wq", "wzlxejny", "xdubsiny", "xqzaqw", "ydkvxd"]},
