    {"argsPy": "r = rng(2121)\nm = n = 12\nboard = [[r.choice('abcdefgh') for _ in range(n)] for _ in range(m)]\ndef walk(k):\n    while True:\n        path = [(r.randrange(m), r.randrange(n))]\n        while len(path) < k:\n            i, j = path[-1]\n            nxt = [(a, b) for a, b in ((i + 1, j), (i - 1, j), (i, j + 1), (i, j - 1))\n                   if 0 <= a < m and 0 <= b < n and (a, b) not in path]\n            if not nxt:\n                break\n            path.append(r.choice(nxt))\n        if len(path) == k:\n            return ''.join(board[a][b] for a, b in path)\nwords = {walk(r.randint(5, 10)) for _ in range(100)}\nwhile len(words) < 300:\n    words.add(''.join(r.choice('abcdefgh') for _ in range(r.randint(4, 10))))\nwords = sorted(words)\nr.shuffle(words)\nargs = [board, words]", "label": "12x12 board, 300 words", "expected": ["aabfafbadf", "aaceegdgcb", "abceh", "abfaffdhba", "abgagb", "acbhdfd", "acgchhg", "acggg", "adbbedeaba", "aecaegbh", "aegh", "aehh", "afaad", "afbadfaab", "afbadfee", "afedefdh", "agbb", "agbdagdge", "agcbb", "ageecaedb", "agehge", "ahacgbd", "ahbfgab", "ahecdgbdg", "ahgeb", "ahgeba", "ahhfdcgbd", "badaaabhdf", "badfaadfdh", "bbgabbdc", "bbgffgbfa", "bcgahcbehe", "bddgadgcg", "bdgcbe", "bdgcgbfaed", "beegdhebdg", "begab", "bfdg", "bfdgbgagg", "bffgha", "bgagdgcbbh", "bgdfafbad", "bgdgec", "bgfgcghfhb", "bhfeebe", "cbga", "cdgh", "ceeghadgg", "ceha", "cgabc", "cgdbege", "cgebgdgf", "chdbgceeb", "chhdfdb", "dabaafd", "dabhdaaf", "dadegfg", "dbgfgd", "dbhhbagggb", "ddbdah", "ddgbc", "ddgbdgce", "ddgehfdbc", "dehcdhafb", "dfaadfa", "dfdhh", "dfede", "dgcbf", "dgeeadcg", "dgggcbh", "dghddd", "dhgggcbag", "eaaega", "ebgdhcg", "echha", "edhhcgbhg", "eeabgdf", "eeach", "eecdd", "efgbhag", "egda", "egeccbdg", "ehcgbef", "ehege", "ehhb", "faddfafda", "fafdabffdd", "faffdb", "fehage", "ffgeb", "fgabhhdf", "fgchegef", "fgdd", "fgec", "fhbahfae", "gbbcgaged", "gbdbdha", "gbgfgdeegb", "gcbagg", "gcgdbgah", "gcgefgdfa", "gchcfd", "gdbcb