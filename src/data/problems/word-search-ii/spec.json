  "starter": "class Solution:\n    def findWords(self, board: List[List[str]], words: List[str]) -> List[str]:\n        pass\n",
  "tests": [
    {"args": [[["s", "e", "a", "t"], ["n", "o", "t", "e"], ["d", "i", "r", "s"]], ["seat", "sea", "note", "tot", "dirt", "rose"]], "show": true, "expected": ["dirt", "note", "sea", "seat"]},
    {"args": [[["a", "b"], ["b", "a"]], ["ab", "abba", "aa", "abab"]], "show": true, "expected": ["ab", "abab"]},
    {"args": [[["z"]], ["zz", "z"]], "show": true, "expected": ["z"]},
    {"args": [[["c", "a"], ["t", "s"]], ["cs", "at", "dog", "tact"]], "label": "no word fits", "expected": []},
