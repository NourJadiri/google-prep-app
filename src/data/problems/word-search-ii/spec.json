    {"args": [[["a", "b"], ["c", "d"]], ["abdca", "abdc", "acdb", "abcd"]], "label": "no diagonals, no cell twice", "expected": ["abdc", "acdb"]},
    {"args": [[["a", "p", "p"], ["x", "y", "l"], ["q", "z", "e"]], ["apple", "app", "apply", "appl", "ape", "pl"]], "label": "words that are prefixes of other words", "expected": ["app", "appl", "apple", "apply", "pl"]},
    {"args": [[["a", "a", "a"], ["a", "a", "a"], ["a", "a", "a"]], ["a", "aa", "aaa", "aaaa", "aaaaa", "aaaaaa", "aaaaaaa", "aaaaaaaa", "aaaaaaaaa", "aaaaaaaaaa"]], "label": "one letter everywhere: nine cells, nine letters at most", "expected": ["a", "aa", "aaa", "aaaa", "aaaaa", "aaaaaa", "aaaaaaa", "aaaaaaaa", "aaaaaaaaa"]},
    {"args": [[["a", "b", "a"], ["b", "a", "b"], ["a", "b", "a"]], ["aba", "bab", "abab", "babab", "aa", "bb"]], "label": "each word reachable along many paths", "expected": ["aba", "abab", "bab", "babab"]},
    {"args": [[["c", "a", "r"], ["x", "t", "x"]], ["cat", "rat", "car", "tar"]], "label": "words sharing cells are found independently", "expected": ["car", "cat", "rat", "tar"]},
