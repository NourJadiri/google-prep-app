    {"argsPy": "r = rng(2122)\nboard = [['a'] * 12 for _ in range(11)] + [list('bcdefghijklm')]\nwords = set()\nwhile len(words) < 5000:\n    k = r.randint(3, 5)\n    words.add('a' * k + ''.join(r.choice('bcdefghijklm') for _ in range(r.randint(1, 10 - k))))\nwords = sorted(words)\nr.shuffle(words)\nargs = [board, words]", "label": "large: 5,000 words sharing their first letters", "perf": true, "expected": ["aaaaab", "aaaaabc", "aaaaac", "aaaaacb", "aaaaacd", "aaaaad", "aaaaadc", "aaaaade", "aaaaae", "aaaaaed", "aaaaaedc", "aaaaaef", "aaaaaefg", "aaaaaf", "aaaaafe", "aaaaag", "aaaaagf", "aaaaagfe", "aaaaagh", "aaaaah", "aaaaahg", "aaaaahi", "aaaaai", "aaaaaih", "aaaaaij", "aaaaaj", "aaaaaji", "aaaaajih", "aaaaajk", "aaaaajkl", "aaaaak", "aaaaakj", "aaaaakl", "aaaaal", "aaaaalk", "aaaaalm", "aaaaam", "aaaaaml", "aaaab", "aaaabc", "aaaac", "aaaacd", "aaaacde", "aaaad", "aaaadc", "aaaade", "aaaae", "aaaaed", "aaaaef", "aaaaefg", "aaaaf", "aaaafe", "aaaafg", "aaaag", "aaaagh", "aaaaghi", "aaaah", "aaaahg", "aaaai", "aaaaih", "aaaaijk", "aaaaj", "aaaaji", "aaaajk", "aaaak", "aaaakj", "aaaakji", "aaaakl", "aaaal", "aaaalk", "aaaalm", "aaaam", "aaaaml", "aaab", "aaabcd", "aaac", "aaacb", "aaacd", "aaacde", "aaad", "aaadc", "aaade", "aaae", "aaaed", "aaaf", "aaafe", "aaafedc", "aaafg", "aaag", "aaagf", "aaagh", "aaah", "aaahg", "aaahi", "aaai", "aaaih", "aaaij", "aaaj", "aaaji", "aaajk", "aaajkl", "aaak", "aaakj", "aaakl", "aaal", "aaalk", "aaalm", "aaam", "aaaml"]},
