  "tests": [
    {"args": [[2, 5, 9], [1, 5, 6, 12]], "expected": [1, 2, 5, 5, 6, 9, 12], "show": true},
    {"args": [[], [-7, 3]], "expected": [-7, 3], "show": true},
    {"args": [[10, 20, 30], [1, 2, 3]], "expected": [1, 2, 3, 10, 20, 30], "show": true},
    {"args": [[], []], "expected": [], "label": "both lists empty"},
    {"args": [[4], []], "expected": [4], "label": "the second list is empty"},
    {"args": [[1], [2]], "expected": [1, 2], "label": "one node each"},
    {"args": [[2], [1]], "expected": [1, 2], "label": "one node each, the second one smaller"},
    {"args": [[3, 3, 3], [3, 3]], "expected": [3, 3, 3, 3, 3], "label": "every value the same"},
    {"args": [[-100, 0, 100], [-100, 100]], "expected": [-100, -100, 0, 100, 100], "label": "smallest and largest values"},
    {"args": [[1, 3, 5, 7], [2, 4, 6, 8]], "expected": [1, 2, 3, 4, 5, 6, 7, 8], "label": "the lists take turns perfectly"},
    {"args": [[5], [1, 2, 3, 4, 6]], "expected": [1, 2, 3, 4, 5, 6], "label": "a single node lands in the middle"},
    {"args": [[1, 2, 3, 4, 5, 6], [7]], "expected": [1, 2, 3, 4, 5, 6, 7], "label": "a single node goes at the very end"},
    {"args": [[1, 1, 2, 2], [1, 2, 2, 3]], "expected": [1, 1, 1, 2, 2, 2, 2, 3], "label": "duplicates across both lists"},
