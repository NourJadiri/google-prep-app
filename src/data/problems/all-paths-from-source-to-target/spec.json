  "tests": [
    {"args": [[[1, 2, 3], [4], [1, 4], [4], []]], "expected": [[0, 1, 4], [0, 2, 1, 4], [0, 2, 4], [0, 3, 4]], "show": true},
    {"args": [[[1, 2], [], [1]]], "expected": [[0, 2]], "show": true},
    {"args": [[[1], [], [1]]], "expected": [], "show": true},
    {"args": [[[1], []]], "expected": [[0, 1]], "label": "smallest: a single edge"},
    {"args": [[[], []]], "expected": [], "label": "smallest: no edge at all"},
    {"args": [[[], [0]]], "expected": [], "label": "the only edge points into node 0"},
    {"args": [[[2, 1], [2], []]], "expected": [[0, 2], [0, 1, 2]], "label": "a direct edge and a detour"},
