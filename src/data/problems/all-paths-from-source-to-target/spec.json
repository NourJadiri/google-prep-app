    {"args": [[[1, 2, 3], [], [4], [], []]], "expected": [[0, 2, 4]], "label": "dead ends that aren't the target"},
    {"args": [[[1, 3], [3], [], [2]]], "expected": [[0, 1, 3], [0, 3]], "label": "the target has an edge out"},
