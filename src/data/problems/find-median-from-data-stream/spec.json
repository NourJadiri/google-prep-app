  "tests": [
    {"ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [6], [], [10], [], [2], []], "expected": [null, null, 6.0, null, 8.0, null, 6.0], "show": true},
    {"ops": ["MedianFinder", "addNum", "addNum", "findMedian", "addNum", "addNum", "findMedian"], "args": [[], [-3], [-8], [], [4], [1], []], "expected": [null, null, null, -5.5, null, null, -1.0], "show": true},
    {"ops": ["MedianFinder", "addNum", "findMedian", "findMedian"], "args": [[], [-100000], [], []], "expected": [null, null, -100000.0, -100000.0], "show": true},
    {"ops": ["MedianFinder", "addNum", "addNum", "findMedian"], "args": [[], [1], [2], []], "expected": [null, null, null, 1.5], "label": "mean of 1 and 2 is 1.5"},
    {"ops": ["MedianFinder", "addNum", "addNum", "findMedian"], "args": [[], [-1], [-2], []], "expected": [null, null, null, -1.5], "label": "mean of -1 and -2 is -1.5"},
    {"ops": ["MedianFinder", "addNum", "addNum", "addNum", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [7], [7], [7], [7], [], [7], []], "expected": [null, null, null, null, null, 7.0, null, 7.0], "label": "one value repeated"},
    {"ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [0], [], [0], [], [0], []], "expected": [null, null, 0.0, null, 0.0, null, 0.0], "label": "zeros"},
