    {"ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [5], [], [1], [], [9], [], [5], [], [5], []], "expected": [null, null, 5.0, null, 3.0, null, 5.0, null, 5.0, null, 5.0], "label": "new values land around the median"},
    {"ops": ["MedianFinder", "addNum", "addNum", "findMedian", "findMedian", "findMedian", "addNum", "findMedian", "findMedian"], "args": [[], [3], [8], [], [], [], [1], [], []], "expected": [null, null, null, 5.5, 5.5, 5.5, null, 3.0, 3.0], "label": "findMedian repeated with no adds between"},
    {"ops": ["MedianFinder", "addNum", "addNum", "addNum", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [2], [4], [6], [8], [], [3], [], [7], [], [5], []], "expected": [null, null, null, null, null, 5.0, null, 4.0, null, 5.0, null, 5.0], "label": "every new value falls in the middle"},
