  "kind": "function",
  "entry": "isPalindrome",
  "params": [{"name": "head", "type": "ListNode"}],
  "starter": "# class ListNode:\n#     def __init__(self, val=0, next=None):\n#         self.val = val\n#         self.next = next\n\nclass Solution:\n    def isPalindrome(self, head: Optional[ListNode]) -> bool:\n        pass\n",
  "tests": [
    {"args": [[3, 1, 4, 1, 3]], "expected": true, "show": true},
    {"args": [[6, 2, 6, 2]], "expected": false, "show": true},
    {"args": [[9]], "expected": true, "show": true},
    {"args": [[0, 0]], "expected": true, "label": "two equal nodes"},
    {"args": [[1, 2]], "expected": false, "label": "two different nodes"},
    {"args": [[5, 7, 5]], "expected": true, "label": "three nodes"},
    {"args": [[5, 7, 7]], "expected": false, "label": "three nodes, the ends differ"},
    {"args": [[2, 4, 4, 2]], "expected": true, "label": "even length"},
    {"args": [[1, 2, 3, 1]], "expected": false, "label": "first and last match, the inside doesn't"},
    {"args": [[7, 0, 3, 5, 0, 7]], "expected": false, "label": "only the middle pair differs"},
    {"args": [[1, 1, 2, 1]], "expected": false, "label": "one value out of place"},
    {"args": [[3, 3, 3, 3, 3, 3, 3]], "expected": true, "label": "every value the same"},
    {"args": [[0, 9, 0, 9, 0]], "expected": true, "label": "smallest and largest values"},
    {"args": [[5, 4, 0, 9, 6, 8, 8, 6, 9, 0, 4, 5]], "expected": true, "label": "random palindrome, even length"},
    {"args": [[7, 3, 4, 5, 5, 7, 9, 1, 4, 6, 6, 9, 0, 9, 6, 6, 4, 1, 9, 7, 5, 5, 4, 3, 7]], "expected": true, "label": "random palindrome, odd length"},
    {"args": [[6, 6, 4, 4, 0, 6, 4, 1, 1, 9, 4, 3, 4, 3, 6, 2, 9, 6, 0, 4, 4, 0, 6, 9, 2, 6, 3, 4, 3, 4, 9, 1, 1, 4, 6, 0, 4, 4, 6, 6]], "expected": true, "label": "random palindrome"},
    {"args": [[3, 9, 5, 1, 0, 3, 4, 3, 9, 1, 5, 9, 3]], "expected": false, "label": "random, one value changed"},
    {"args": [[6, 1, 1, 2, 9, 2, 0, 4, 1, 7, 6, 1, 1, 2, 0, 0, 2, 1, 1, 6, 7, 1, 4, 0, 2, 9, 2, 1, 1, 5]], "expected": false, "label": "random, one value changed"},
    {"args": [[6, 1, 6, 7, 6, 6, 2, 8, 8, 0, 0, 8, 0, 7, 1, 9, 0, 9, 5, 8, 9, 8, 5, 9, 0, 9, 1, 7, 0, 8, 0, 0, 8, 8, 2, 6, 6, 4, 6, 1, 6]], "expected": false, "label": "random, one value changed"},
    {"argsPy": "r = rng(2340)\nhalf = [r.randint(0, 9) for _ in range(5000)]\nargs = [half + half[::-1]]", "expected": true, "label": "large: 10,000 nodes, a palindrome", "perf": true},
    {"argsPy": "r = rng(2341)\nhalf = [r.randint(0, 9) for _ in range(5000)]\nvals = half + half[::-1]\nvals[5000] = (vals[5000] + 1) % 10\nargs = [vals]", "expected": false, "label": "large: 10,000 nodes, only the middle pair differs", "perf": true}
  ]
}
