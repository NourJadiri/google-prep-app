    {"args": [[15, 18, 22, 3, 7, 11], 7], "expected": 4, "show": true},
    {"args": [[30, 40, 50, 10, 20], 35], "expected": -1, "show": true},
    {"args": [[2, 4, 6, 8, 10], 10], "expected": 4, "show": true},
    {"args": [[9], 9], "expected": 0, "label": "one element, found"},
    {"args": [[9], 4], "expected": -1, "label": "one element, missing"},
    {"args": [[6, 2], 2], "expected": 1, "label": "two elements, rotated: target second"},
    {"args": [[6, 2], 6], "expected": 0, "label": "two elements, rotated: target first"},
    {"args": [[2, 6], 6], "expected": 1, "label": "two elements, not rotated"},
    {"args": [[6, 2], 4], "expected": -1, "label": "two elements, missing"},
    {"args": [[40, 50, 60, 5, 10, 20, 30], 5], "expected": 3, "label": "target is the smallest value (the pivot)"},
    {"args": [[40, 50, 60, 5, 10, 20, 30], 60], "expected": 2, "label": "target is the largest value"},
    {"args": [[12, 14, 16, 2, 4], 12], "expected": 0, "label": "target at index 0"},
    {"args": [[12, 14, 16, 2, 4], 4], "expected": 4, "label": "target at the last index"},
    {"args": [[8, 1, 2, 3, 4, 5, 6, 7], 7], "expected": 7, "label": "rotated by n - 1: only the largest value in front"},
    {"args": [[2, 3, 4, 5, 6, 7, 8, 1], 1], "expected": 7, "label": "rotated by one: the smallest value at the back"},
    {"args": [[5, 1, 3], 5], "expected": 0, "label": "three elements, target first"},
    {"args": [[5, 1, 3], 3], "expected": 2, "label": "three elements, target last"},
    {"args": [[7, 9, 1, 3], 5], "expected": -1, "label": "missing: falls between the two runs"},
    {"args": [[-3, 0, 4, 9, -20, -11, -7], -11], "expected": 5, "label": "negative values"},
    {"args": [[100, 200, 300, -50, 0], -1000], "expected": -1, "label": "missing: below every value"},
