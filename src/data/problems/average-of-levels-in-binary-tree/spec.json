{
  "id": "average-of-levels-in-binary-tree",
  "title": "Average of Levels in Binary Tree",
  "difficulty": "E",
  "lc": {"num": 637, "slug": "average-of-levels-in-binary-tree"},
  "topics": ["binary tree", "bfs", "queue"],
  "kind": "function",
  "entry": "averageOfLevels",
  "params": [{"name": "root", "type": "TreeNode"}],
  "starter": "# class TreeNode:\n#     def __init__(self, val=0, left=None, right=None):\n#         self.val = val\n#         self.left = left\n#         self.right = right\n\nclass Solution:\n    def averageOfLevels(self, root: Optional[TreeNode]) -> List[float]:\n        pass\n",
  "tests": [
    {"args": [[10, 4, 7, null, 1, 0]], "expected": [10.0, 5.5, 0.5], "show": true},
    {"args": [[-3, 8, null, -6, 5]], "expected": [-3.0, 8.0, -0.5], "show": true},
    {"args": [[2147483647, 2147483647, 2147483647]], "expected": [2147483647.0, 2147483647.0], "show": true},
    {"args": [[0]], "expected": [0.0], "label": "one node"},
    {"args": [[-2147483648]], "expected": [-2147483648.0], "label": "one node, the smallest value"},
    {"args": [[9, 2, 3, 1, 0, null, 0]], "expected": [9.0, 2.5, 0.3333333333333333], "label": "an average that never ends: 1/3"},
    {"args": [[0, -2147483648, 2147483647]], "expected": [0.0, -0.5], "label": "both extremes on one level"},
    {"args": [[4, -1, -2]], "expected": [4.0, -1.5], "label": "a negative half: -1.5, not -2"},
    {"args": [[12, -25, null, null, -16, null, -32, -44, null, 7]], "expected": [12.0, -25.0, -16.0, -32.0, -44.0, 7.0], "label": "a path: one node per level"},
    {"args": [[1, 35, -42, -32, 36, 41, -27, -46, 49, 28, 37, 35, -18, 22, 11]], "expected": [1.0, -3.5, 4.5, 14.75], "label": "perfect tree, 4 levels"},
    {"args": [[1, 2, 3, 4, null, null, 5, null, 6, 7]], "expected": [1.0, 2.5, 4.5, 6.5], "label": "cousins far apart"},
