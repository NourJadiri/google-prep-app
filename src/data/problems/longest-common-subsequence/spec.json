  "entry": "longestCommonSubsequence",
  "params": [{"name": "text1"}, {"name": "text2"}],
  "starter": "class Solution:\n    def longestCommonSubsequence(self, text1: str, text2: str) -> int:\n        pass\n",
  "tests": [
    {"args": ["stone", "longest"], "expected": 3, "show": true},
    {"args": ["kite", "plum"], "expected": 0, "show": true},
    {"args": ["abcd", "dcba"], "expected": 1, "show": true},
    {"args": ["a", "a"], "expected": 1, "label": "one letter each, equal"},
    {"args": ["a", "b"], "expected": 0, "label": "one letter each, different"},
    {"args": ["abcab", "abcab"], "expected": 5, "label": "identical strings"},
    {"args": ["pig", "spring"], "expected": 3, "label": "one string is a subsequence of the other"},
    {"args": ["aaaa", "aa"], "expected": 2, "label": "repeated letters"},
    {"args": ["zabc", "abcz"], "expected": 3, "label": "matching the first letter eagerly is a trap"},
    {"args": ["axbxc", "abc"], "expected": 3, "label": "a subsequence, not a substring"},
    {"args": ["ababab", "bababa"], "expected": 5, "label": "shifted by one"},
    {"args": ["mississippi", "sip"], "expected": 3, "label": "short pattern in a long word"},
    {"args": ["", "q"], "expected": 1, "label": "1000 letters vs 1"},
    {"args": ["q", ""], "expected": 0, "label": "1 letter vs 1000, no match"},
    {"args": ["zqx", ""], "expected": 3, "label": "3 letters vs 1000"},
    {"args": ["bbbbcbcab", "aaccabbbaac"], "expected": 4, "label": "random"},
    {"args": ["cbcdcbbdbbda", "dddadbccba"], "expected": 5, "label": "random"},
    {"args": ["ffcigigj", "jfgfjibhhdif"], "expected": 4, "label": "random"},
    {"args": ["bbabaaabbabb", "bbbbababaabb"], "expected": 9, "label": "random"},
    {"argsPy": "r = rng(11436)\nargs = [''.join(r.choice('abcdefghijklmnopqrstuvwxyz') for _ in range(500)),\n        ''.join(r.choice('abcdefghijklmnopqrstuvwxyz') for _ in range(500))]", "expected": 155, "label": "large: 500 x 500, all 26 letters", "perf": true},
    {"argsPy": "r = rng(11437)\nargs = [''.join(r.choice('ab') for _ in range(500)), ''.join(r.choice('ab') for _ in range(500))]", "expected": 401, "label": "large: 500 x 500, two letters", "perf": true},
    {"argsPy": "r = rng(11438)\ns = ''.join(r.choice('abcdefghijklmnopqrstuvwxyz') for _ in range(1000))\nargs = [s, s]", "expected": 1000, "label": "large: 1000 letters, identical strings", "perf": true}
  ]
}
